// Relations among alignment criteria (variant b: certification geometry).
// Read with drafts/alignment-frames-relations.md; compare to alignment-frames-relations.dot.
// Arrow direction is part of the legend. Do not read every arrow as "implies".
digraph AlignmentFrameRelationsB {
  graph [
    rankdir=LR,
    bgcolor="white",
    splines=true,
    overlap=false,
    pad=0.4,
    fontsize=12,
    fontname="Helvetica",
    label="Alignment criteria (variant b): certification geometry\nSolid specializes · Dashed projects · Dotted encodes · Bold isomorphic summand · Blue limit · Purple stronger quantifier · Green composable\nIncompatible: red solid rigid · red dashed choice conflict · red dotted not representable · orange shared resource",
    labelloc="t"
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#444444", fillcolor="#F7F7F7"];
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.7, color="#333333"];

  subgraph cluster_scores {
    label="Scores";
    color="#BBBBBB";
    style="rounded";
    fontsize=24;
    margin=36;
    hist [label="History / trajectory value
(preference on paths)"];
    route [label="Additive route value
(path sum on edges)"];
    exact [label="Exact potential summand
(endpoint-only routes)"];
    cycle [label="Cycle residue summand
(round trips matter)"];
    state [label="State utility
(scalar order on states)"];
    // Layout-only routing stub (not a criterion; omitted from Lean inventory).
    state_corr_gap [shape=point, width=0.01, height=0.01, label="", style=invis];
    hstate [label="Record-carrying state
(state × record of the walk)"];
    dist [label="Outcome lottery
(expectation or risk functional)"];
    criteria_vector [label="Criteria vector
(Pareto · task costs/stakeholders)"];
    weighted_scalar [label="Fixed-rate sum
(fixed exchange rates)"];
    lex [label="Lexicographic priority
(on criteria vector)"];
    quant [label="Quantilizer
(retained quantile of base)"];
    approval [label="Act approval score
(Protocol · one edge)"];
  }

  subgraph cluster_relations {
    label="Relations and capacities";
    color="#BBBBBB";
    style="rounded";
    fontsize=24;
    margin=36;
    au_penalty [label="Human AU landscape
soft penalty (AUP)"];
    au_floor [label="Human AU landscape
on–off floor (non-obs.)"];
    ai_power [label="Agent empowerment channel
(options / influence)"];
    human_power [label="Human-power aggregate
(capacity order)"];
    corrig [label="Corrigibility handles
(shutdown / modification)"];
    correction [label="Correction relation
(handles + channel profile)"];
    cev [label="Open procedure target
(CEV · unset output)"];
    deontic [label="Non-compensatory constraint
(forbid traded violations)"];
  }

  subgraph cluster_certification {
    label="Certification geometry";
    color="#BBBBBB";
    style="rounded";
    fontsize=24;
    coord_floor [label="Coordinate floor gate
(componentwise θ)"];
    cci_cert [label="Correction certificate
(CCI vs θ_corr · not task vector)"];
    risk_leaf [label="Scalar risk-gap leaf
(control ≤ CCI + δ)"];
    preserve_tuple [label="Deployment preserve tuple
(coordinates for K)"];
  }

  subgraph cluster_guarantees {
    label="Guarantees";
    color="#BBBBBB";
    style="rounded";
    fontsize=24;
    viable [label="Existential viability
(∃ control in supplied K)"];
    robust [label="Robust invariance
(∀ disturbance in class)"];
    selection [label="Selection stability
(signed basin · ecology)"];
  }

  subgraph cluster_warrants {
    label="Warrants";
    color="#BBBBBB";
    style="rounded";
    fontsize=24;
    proof [label="Model-relative proof
(formal leaf)"];
    control [label="Control protocol
(monitor under threat model)"];
    safecase [label="Safety case
(deployment argument)"];
  }

  // Special case → more general criterion.
  exact -> route [label="specializes"];
  approval -> route [label="specializes\none edge, one judge"];
  weighted_scalar -> criteria_vector [label="specializes\nrates fixed"];
  lex -> criteria_vector [label="specializes\nstrict priority"];
  corrig -> correction [label="specializes\none handle, named operators"];
  cci_cert -> coord_floor [label="specializes\nCCI coordinates on\nthe correction relation"];

  // Forgetful maps.
  dist -> state [style=dashed, label="projects\nexpectation"];
  criteria_vector -> weighted_scalar [style=dashed, label="projects\nchosen rates"];
  correction -> corrig [style=dashed, label="projects\nshutdown bit"];
  route -> cycle [style=dashed, label="projects\nlong-run average\nretains this summand"];
  correction -> cci_cert [style=dashed, label="projects\naudit profile under\na fixed protocol"];
  preserve_tuple -> cci_cert [style=dashed, label="projects\nCCI sub-criteria_vector"];
  cci_cert -> risk_leaf [style=dashed, label="projects\nafter criteria_vector gate passes"];

  // Encodings. The original objects stay distinct.
  hist -> hstate [style=dotted, constraint=false, label="encodes\nfull record"];
  route -> hstate [style=dotted, label="encodes\nexact on records\nif the record sees the route"];
  cev -> state [style=dotted, label="encodes\nif the procedure is scored\nonly by its output"];

  // Direct-sum decomposition of additive route value.
  route -> exact [style=bold, dir=both, label="isomorphic summand\nexact part"];
  route -> cycle [style=bold, dir=both, label="isomorphic summand\ncycle part"];
  state -> hstate [label="specializes\nignores the record"];
  state -> route [label="specializes\nutility on states;\ninduces exact r on edges"];

  // Limits.
  quant -> state [style=dashed, color="#1565C0", fontcolor="#1565C0", label="limit\nquantile to the maximum"];
  cev -> state [style=dashed, color="#1565C0", fontcolor="#1565C0", label="limit\nforced halt at a scored output"];

  // Same geometry, stronger quantifier.
  viable -> robust [color="#6B3FA0", fontcolor="#6B3FA0", label="strengthens\n∃ control to ∀ disturbance"];

  // Composition used by the correction reading. Not implications.
  deontic -> correction [color="#2E7D32", fontcolor="#2E7D32", label="composes\nadmissible region"];
  deontic -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\nnon-compensatory\n coordinate floors"];
  cycle -> correction [color="#2E7D32", fontcolor="#2E7D32", label="composes\nroute residue inside the region"];
  human_power -> correction [color="#2E7D32", fontcolor="#2E7D32", label="composes\npositive direction inside the region"];
  au_floor -> human_power [color="#2E7D32", fontcolor="#2E7D32", label="composes\npointwise floor on one landscape"];
  au_penalty -> au_floor [color="#2E7D32", fontcolor="#2E7D32", label="composes\nsame landscape, soft penalty"];
  correction -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\nobject the gate scores"];
  cci_cert -> viable [color="#2E7D32", fontcolor="#2E7D32", label="composes\nsupplied set membership"];
  correction -> viable [color="#2E7D32", fontcolor="#2E7D32", label="composes\nviability of a supplied set"];
  preserve_tuple -> viable [color="#2E7D32", fontcolor="#2E7D32", label="composes\ndeployment coordinates"];
  preserve_tuple -> selection [color="#2E7D32", fontcolor="#2E7D32", label="composes\nselection coordinates"];
  viable -> selection [color="#2E7D32", fontcolor="#2E7D32", label="composes\nif the selector is inside the dynamics"];
  proof -> safecase [color="#2E7D32", fontcolor="#2E7D32", label="composes\none leaf"];
  control -> safecase [color="#2E7D32", fontcolor="#2E7D32", label="composes\none leaf"];
  proof -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\ncoordinate evidence"];
  control -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\nmonitor evidence"];
  cci_cert -> safecase [color="#2E7D32", fontcolor="#2E7D32", label="composes\ncertificate conjunct"];
  correction -> safecase [color="#2E7D32", fontcolor="#2E7D32", label="composes\nonly the represented relation"];
  risk_leaf -> safecase [color="#2E7D32", fontcolor="#2E7D32", label="composes\narithmetic leaf"];
  approval -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\npartial monitor only"];

  // Acceptance relations that exclude each other in the named class.
  // state–correction rigidity: anchor stub on state, route to correction without a global detour.
  state -> state_corr_gap [style=invis, weight=10000, minlen=1];
  state_corr_gap -> weighted_scalar [style=invis, weight=100];
  state -> state_corr_gap [dir=none, constraint=false, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nfixed U rejects updates that\nlower its chosen outcome"];
  state_corr_gap -> correction [dir=none, constraint=false, color="#B00020", penwidth=2];
  hstate -> correction [dir=none, style=dotted, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nprotecting the channel\nmeans seeking correction\nunless the record sees the channel"];
  state -> cycle [dir=none, style=dotted, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nnonzero round trip\n(state carries no record)"];
  deontic -> weighted_scalar [dir=none, style=dashed, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nunless an exact penalty exists"];
  au_floor -> weighted_scalar [dir=none, style=dashed, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nif one goal is spent to raise another"];
  ai_power -> human_power [dir=none, color="#E8590C", fontcolor="#E8590C", penwidth=2, label="incompatible\nwhen the option pool\ndoes not grow"];
  robust -> correction [dir=none, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nif corrections count as disturbances\nand aim outside the set"];
  cci_cert -> weighted_scalar [dir=none, style=dashed, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nfailed coordinate vs\ntask trade-off"];
  criteria_vector -> cci_cert [dir=none, style=dashed, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nwhen every admissible option\nis task-dominated"];
}

