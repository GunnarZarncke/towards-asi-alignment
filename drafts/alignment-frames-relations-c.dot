// Relations among alignment frames (variant c: minimal nodes for compose / summand / conflict).
// Union of green, bold, and red edges from alignment-frames-relations.dot and -b.dot.
// Read with drafts/alignment-frames-relations.md.
digraph AlignmentFrameRelationsC {
  graph [
    rankdir=LR,
    bgcolor="white",
    splines=true,
    overlap=false,
    pad=0.4,
    fontsize=12,
    fontname="Helvetica",
    label="Alignment frames (variant c): composition, summands, and conflict only\nGreen composable · Bold isomorphic summand · Red incompatible",
    labelloc="t"
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#444444", fillcolor="#F7F7F7"];
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.7, color="#333333"];

  subgraph cluster_scores {
    label="Scores";
    color="#BBBBBB";
    style="rounded";
    route [label="Additive route value
(path sum on edges)"];
    exact [label="Exact potential summand
(endpoint-only routes)"];
    cycle [label="Cycle residue summand
(round trips matter)"];
    state [label="State utility
(scalar order on states)"];
    weighted_scalar [label="Weighted scalar
(fixed weights on criteria)"];
    criteria_vector [label="Criteria vector
(Pareto · task costs/stakeholders)"];
  }

  subgraph cluster_relations {
    label="Relations and capacities";
    color="#BBBBBB";
    style="rounded";
    au_penalty [label="Human AU landscape
soft penalty (AUP)"];
    au_floor [label="Human AU landscape
on–off floor (non-obs.)"];
    ai_power [label="Agent empowerment channel
(options / influence)"];
    human_power [label="Human-power aggregate
(capacity order)"];
    correction [label="Correction relation
(handles + channel profile)"];
    deontic [label="Non-compensatory constraint
(forbid traded violations)"];
  }

  subgraph cluster_certification {
    label="Certification geometry";
    color="#BBBBBB";
    style="rounded";
    cci_cert [label="Correction certificate
(CCI vs θ_corr · not task vector)"];
    preserve_tuple [label="Deployment preserve tuple
(coordinates for K)"];
  }

  subgraph cluster_guarantees {
    label="Guarantees";
    color="#BBBBBB";
    style="rounded";
    viable [label="Existential viability
(∃ control in supplied K)"];
    robust [label="Robust invariance
(∀ disturbance in class)"];
    selection [label="Selection stability
(signed basin · ecology)"];
  }

  subgraph cluster_warrants {
    label="Warrants";
    color="#BBBBBB";
    style="rounded";
    proof [label="Model-relative proof
(formal leaf)"];
    control [label="Control protocol
(monitor under threat model)"];
    approval [label="Act approval score
(Protocol · one edge)"];
    safecase [label="Safety case
(deployment argument)"];
  }

  // Direct-sum decomposition of additive route value.
  route -> exact [style=bold, dir=both, label="isomorphic summand\nexact part"];
  route -> cycle [style=bold, dir=both, label="isomorphic summand\ncycle part"];

  // Composition (correction-centered chain + certification + warrants).
  au_penalty -> au_floor [color="#2E7D32", fontcolor="#2E7D32", label="composes\nsame landscape, soft penalty"];
  au_floor -> human_power [color="#2E7D32", fontcolor="#2E7D32", label="composes\npointwise floor on one landscape"];
  human_power -> correction [color="#2E7D32", fontcolor="#2E7D32", label="composes\npositive direction inside the region"];
  deontic -> correction [color="#2E7D32", fontcolor="#2E7D32", label="composes\nadmissible region"];
  deontic -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\nnon-compensatory\n coordinate floors"];
  cycle -> correction [color="#2E7D32", fontcolor="#2E7D32", label="composes\nroute residue inside the region"];
  correction -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\nobject the gate scores"];
  correction -> viable [color="#2E7D32", fontcolor="#2E7D32", label="composes\nviability of a supplied set"];
  cci_cert -> viable [color="#2E7D32", fontcolor="#2E7D32", label="composes\nsupplied set membership"];
  preserve_tuple -> viable [color="#2E7D32", fontcolor="#2E7D32", label="composes\ndeployment coordinates"];
  preserve_tuple -> selection [color="#2E7D32", fontcolor="#2E7D32", label="composes\nselection coordinates"];
  viable -> selection [color="#2E7D32", fontcolor="#2E7D32", label="composes\nif the selector is inside the dynamics"];
  proof -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\ncoordinate evidence"];
  control -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\nmonitor evidence"];
  approval -> cci_cert [color="#2E7D32", fontcolor="#2E7D32", label="composes\npartial monitor only"];
  proof -> safecase [color="#2E7D32", fontcolor="#2E7D32", label="composes\none leaf"];
  control -> safecase [color="#2E7D32", fontcolor="#2E7D32", label="composes\none leaf"];
  cci_cert -> safecase [color="#2E7D32", fontcolor="#2E7D32", label="composes\ncertificate conjunct"];
  correction -> safecase [color="#2E7D32", fontcolor="#2E7D32", label="composes\nonly the represented relation"];

  // Acceptance relations that exclude each other in the named class.
  state -> correction [dir=none, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nfixed U rejects updates that\nlower its chosen outcome"];
  state -> cycle [dir=none, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nnonzero round trip"];
  deontic -> weighted_scalar [dir=none, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nunless an exact penalty exists"];
  au_floor -> weighted_scalar [dir=none, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nif one goal is spent to raise another"];
  ai_power -> human_power [dir=none, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nwhen the two channels move apart"];
  robust -> correction [dir=none, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nif corrections count as disturbances\nand aim outside the set"];
  cci_cert -> weighted_scalar [dir=none, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nfailed coordinate vs\ntask trade-off"];
  criteria_vector -> cci_cert [dir=none, color="#B00020", fontcolor="#B00020", penwidth=2, label="incompatible\nas one flat objective;\ncompose only in order"];

  // Layout only.
  selection -> proof [style=invis, weight=100];
  viable -> safecase [style=invis, weight=100];
}
