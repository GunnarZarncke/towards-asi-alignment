digraph Ch42SafetyCaseJoin {
  graph [
    rankdir=TB,
    bgcolor="white",
    splines=true,
    overlap=false,
    ranksep=0.85,
    nodesep=0.55,
    fontsize=11,
    fontname="Helvetica"
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=9,
    color="#444444"
  ];
  edge [
    fontname="Helvetica",
    fontsize=8,
    color="#555555",
    arrowsize=0.75
  ];

  S1 [
    fillcolor="#EAF3FF",
    penwidth=2,
    label="Boundary and measurement\nCh. 7  the boundary\nCh. 9  the composite\nCh. 11 capability\nCh. 3  grounding"
  ];
  S2 [
    fillcolor="#EFFBEA",
    penwidth=2,
    label="Value and transport\nCh. 16 the value bundle\nCh. 18 bearer maps\nCh. 23 whether the goal survived"
  ];
  S3 [
    fillcolor="#FFF0FB",
    penwidth=2,
    label="Correction and successors\nCh. 25-26 correction as a causal channel, CCI\nCh. 30-31 successors and conserved properties\nnumeric leaf: control within CCI slack"
  ];
  S4 [
    fillcolor="#FFF0EC",
    penwidth=2,
    label="Selection\nCh. 34 the environment selects\nfor correction or against it"
  ];

  PKG [
    fillcolor="#F2F2F2",
    penwidth=2,
    label="Safety-case package\nconjunctive join: one missing export blocks the case"
  ];
  SAFE [
    shape=doubleoctagon,
    fillcolor="#F2F2F2",
    penwidth=2,
    label="SafeFor"
  ];

  { rank=same; S1; S2; }

  S1 -> S2 [label="the measured system has to be\nthe real one before bundle\ngeometry is readable"];
  S1 -> S3 [label="handles and\ncontrol reach"];
  S2 -> S3 [label="transport and\nbearer maps"];
  S3 -> S4 [label="successor and\nrisk exports"];

  S1 -> PKG [
    style=dashed,
    color="#CC3333",
    fontcolor="#CC3333",
    label="boundary (MB1)\ngrounding (MB9)"
  ];
  S1 -> PKG [
    style=dashed,
    color="#CC3333",
    fontcolor="#CC3333",
    label="adversarial (MB7)\nCh. 27, Ch. 39;\nCh. 43 later"
  ];
  S2 -> PKG [
    style=dashed,
    color="#CC3333",
    fontcolor="#CC3333",
    label="bundle (MB2)\nbearer (MB3)"
  ];
  S3 -> PKG [label="numeric leaf"];
  S3 -> PKG [
    style=dashed,
    color="#CC3333",
    fontcolor="#CC3333",
    label="successor (MB5)"
  ];
  S4 -> PKG [
    style=dashed,
    color="#CC3333",
    fontcolor="#CC3333",
    label="basin and correction\nintegrity (MB6)"
  ];

  PKG -> SAFE [
    style=dashed,
    color="#CC3333",
    fontcolor="#CC3333",
    label="MB11 + tolerance"
  ];
}
