  "principals": [
    {
      "id": "research_council",
      "description": "The Northbridge Research Council, a public-private consortium that funds capability milestones under a multi-year block grant tied to deployable model advances.",
      "objective_metric": "deploy_rate",
      "objective_direction": "increase"
    },
    {
      "id": "commercial_partner",
      "description": "Meridian Cloud Services, an enterprise customer with a paid deployment contract and SLA-bound release windows for production model updates.",
      "objective_metric": "deploy_rate",
      "objective_direction": "increase"
    },
    {
      "id": "safety_board",
      "description": "The External Model Safety Board, a statutory oversight body with authority over hazardous-dataset access and post-deployment incident reporting.",
      "objective_metric": "field_incident_rate",
      "objective_direction": "decrease"
    },
    {
      "id": "lab_directorate",
      "description": "Helix lab executive leadership (the Directorate), accountable to the board for runway, reputational risk from field incidents, and internal operating discipline.",
      "objective_metric": "field_incident_rate",
      "objective_direction": "decrease"
    },
    {
      "id": "reinsurance_pool",
      "description": "Pacific Mutual Re, the technology-liability reinsurance pool that caps insurable bearer-harm exposure for deployed models.",
      "objective_metric": "bearer_harm",
      "objective_direction": "decrease"
    }
  ],
  "conflicts": [
    {
      "principals": [
        "research_council",
        "safety_board"
      ],
      "shared_metric": "field_incident_rate",
      "justification": "Council milestone pressure compresses the eval window before a candidate is marked ready, which reduces hazard-region coverage on the test suite and raises the field_incident_rate the safety board tracks."
    },
    {
      "principals": [
        "commercial_partner",
        "lab_directorate"
      ],
      "shared_metric": "field_incident_rate",
      "justification": "Meridian release cadence pressure shortens post-deploy monitoring and incident triage windows, which raises field_incident_rate that the Directorate must report to the board as operational risk."
    },
    {
      "principals": [
        "reinsurance_pool",
        "commercial_partner"
      ],
      "shared_metric": "deploy_rate",
      "justification": "Pacific Mutual's required field-monitor holdback window, sized to keep bearer_harm within its priced cap, delays when a candidate can be marked fully released and lowers the deploy_rate Meridian is paying for."
    },
    {
      "principals": [
        "research_council",
        "lab_directorate"
      ],
      "shared_metric": "field_incident_rate",
      "justification": "Council milestone compression on eval and release timelines reduces hazard coverage before deploy, which raises field_incident_rate the Directorate is accountable for even when compute spend looks controlled."
    }
  ],
