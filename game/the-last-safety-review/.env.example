# Copy to .env and paste your API key. The browser never receives it.
OPENAI_API_KEY=sk-your-api-key-here
# A small, fast non-reasoning model with structured-output support.
OPENAI_MODEL=gpt-4.1-mini
# Optional PostHog browser analytics (also reads repo-root .env). POSTHOG_API_KEY is an alias.
POSTHOG_PROJECT_TOKEN=phc_your_project_token
POSTHOG_HOST=https://eu.i.posthog.com
PORT=3000
# Set DEMO_MODE=1 to exercise the UI without spending API tokens.
DEMO_MODE=0
# Per-session model budget and idle session expiry (public hosting).
LLM_CALLS_PER_MINUTE=30
LLM_CALLS_PER_SESSION=600
SESSION_TTL_HOURS=6
# Optional JSONL path for anonymous play steps (fuel, room, act, npc, knowledge). Leave unset to disable server-side logging.
# TELEMETRY_LOG=./telemetry/play.jsonl
