{
  "name": "the-last-safety-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.10"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev:ui": "node scripts/dev-ui.mjs",
    "dev:terminal": "node scripts/dev-terminal.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:engine": "node --test tests/engine.test.mjs tests/npc-enumerate.test.mjs tests/incident-strategies.test.mjs tests/access-gates.test.mjs tests/visitor-clearance.test.mjs tests/floorplan.test.mjs tests/playthrough.test.mjs",
    "test:playthrough": "node --test tests/playthrough.test.mjs",
    "test:playthrough:full": "PLAYTHROUGH_FULL=1 node --test tests/playthrough.test.mjs",
    "test:endings": "node --test tests/ending-reachability.test.mjs",
    "test:llm": "node --test tests/llm/*.test.mjs",
    "playtest": "node scripts/playtest.mjs",
    "text": "node scripts/text-play.mjs"
  },
  "dependencies": {
    "posthog-js": "^1.438.12",
    "three": "0.186.1",
    "yaml": "^2.9.1"
  }
}
