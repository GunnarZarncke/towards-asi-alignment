digraph Spine03CorrectionSuccessors {
  graph [
    rankdir=TB,
    bgcolor="white",
    splines=true,
    overlap=false,
    fontsize=11,
    fontname="Helvetica",
    label="Spine III: Correction, risk, and successors",
    labelloc="t"
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, color="#444444"];
  edge [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.7];

  P23 [label="P23 No handle control ⇒ no correction", fillcolor="#FFF0FB"];
  P24 [label="P24 Weakest handle capacity / CCI", fillcolor="#FFF0FB"];
  FSHUT [label="[SUBSUMED]\nField.Shutdown final nodes\nshutdown_optimal_under_correction_preference\nshutdown_separated_from_correction", fillcolor="#FFF0FB", color="#2E7D32", penwidth=2.2];
  FINT [label="Field.Interruptibility final nodes\ninterrupt_policy_invariant_from_correction_interface\ninterrupt_separated_from_correction", fillcolor="#FFF0FB"];
  FIMPACT [label="Field.Impact final nodes\nauxiliary_reachability_preserves_correction_reachability\nreachability_not_correction_capacity", fillcolor="#FFF0FB"];
  FQUANT [label="Field.Quantilization final nodes\nquantile_soundness_preserves_trajectory_cci\nquantile_separated_from_trajectory", fillcolor="#FFF0FB"];
  P25 [label="P25 Obedience ≠ corrigibility", fillcolor="#FFF0FB"];
  FCORR [label="Field.Corrigibility final nodes\nchristian_corrigibility_is_correction_invariant\nact_based_separated_from_dynamical", fillcolor="#FFF0FB"];
  FDEB [label="Field.Debate final nodes\ndebate_truth_is_correction_projection\ndebate_separated_from_judge_correction", fillcolor="#FFF0FB"];
  P25A [label="Amplification\n≠ correction contraction", fillcolor="#FFF0FB"];
  FELK [label="Field.ELK final nodes\nelk_readout_is_correction_projection\nelk_separated_from_uptake", fillcolor="#FFF0FB"];
  P26 [label="P26 Update without fixed point", fillcolor="#FFF0FB"];
  P13 [label="P13 Risk = Control − CCI", fillcolor="#EAF3FF"];
  P29 [label="P29 Self-control gap", fillcolor="#F4EEFF"];
  P27 [label="P27 Successor invariant chain", fillcolor="#F4EEFF"];
  P28 [label="P28 Missing invariant blocks safety", fillcolor="#F4EEFF"];
  P22T [label="Syntactic tiling ≠ import-preserving transport", fillcolor="#EFFBEA"];
  PFORGE [label="forgeability_gap\nall-seven-green + Risk≤δ\n⇏ TrueHarm≤δ", fillcolor="#F4EEFF"];

  MB4 [shape=diamond, fillcolor="#FFE6E6", color="#CC3333", label="MB4 Correction legitimacy"];
  MB5 [shape=diamond, fillcolor="#FFE6E6", color="#CC3333", label="MB5 Successor audit"];
  MB7b [shape=diamond, fillcolor="#FFE6E6", color="#CC3333", label="MB7b (from Spine I)"];
  MB7c [shape=diamond, fillcolor="#FFE6E6", color="#CC3333", label="MB7c Adversarial robustness"];
  MB8 [shape=diamond, fillcolor="#FFE6E6", color="#CC3333", label="MB8 CEV / process convergence"];
  MB10 [shape=diamond, style="filled,dashed", fillcolor="#FFE6E6", color="#CC3333", label="MB10\nConserved-property signature\nnot forged"];

  IN_VB [shape=octagon, style="filled,dashed", fillcolor="#E8F8E8", color="#336633",
         label="From Spine II:\nP22b transport"];
  IN_BND [shape=octagon, style="filled,dashed", fillcolor="#DDEEFF", color="#336699",
          label="From Spine I:\nP11 control, MB7b"];

  OUT [shape=octagon, style="filled", fillcolor="#F0E8FF", color="#663399",
       label="Exports:\nCCI, Risk bound,\nSuccessorSafe, MB7c, MB8,\nTrueHarm bound (MB10)"];

  IN_VB -> P22T -> P27;
  IN_VB -> P27;
  P23 -> P24 -> FSHUT;
  FSHUT -> FINT;
  P24 -> FIMPACT;
  P24 -> FQUANT;
  P24 -> P25 -> FCORR -> P26;
  P25 -> FDEB;
  P25 -> P25A;
  P25 -> FELK;
  P24 -> P13;
  P24 -> P27 -> P28;
  IN_BND -> P13 [label="capability"];
  P29 -> P13;

  MB4 -> P25 [style=dashed, color="#CC3333"];
  MB4 -> FCORR [style=dashed, color="#CC3333"];
  MB5 -> P27 [style=dashed, color="#CC3333"];
  MB5 -> P28 [style=dashed, color="#CC3333"];
  P25 -> MB8 [style=dashed, color="#CC3333"];
  P26 -> MB8 [style=dashed, color="#CC3333"];

  P27 -> PFORGE [label="motivates gate", color="#CC3333"];
  PFORGE -> MB10 [style=dashed, color="#CC3333", label="closes gap"];
  P27 -> MB10 [style=dashed, color="#CC3333"];
  MB10 -> OUT [style=dashed, color="#CC3333"];

  IN_BND -> MB7b [style=dashed, color="#CC3333", label="from Spine I"];
  MB7b -> MB7c [style=dashed, color="#CC3333", label="MB7 chain"];
  MB7c -> OUT [style=dashed, color="#CC3333"];
  P13 -> OUT;
  FINT -> OUT;
  FIMPACT -> OUT;
  FQUANT -> OUT;
  FDEB -> OUT;
  P25A -> OUT;
  FELK -> OUT;
  P27 -> OUT;
  P28 -> OUT;
  MB8 -> OUT [style=dashed, color="#CC3333"];
}
