    "sym:V_{t+1}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="V_{t+1}"];
    "sym:V_{t}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="V_{t}"];
    "sym:w_{1}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="w_{1}"];
    "sym:w_{2}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="w_{2}"];
    "sym:w_{3}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="w_{3}"];
    "sym:w_{4}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="w_{4}"];
    "sym:w_{5}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="w_{5}"];
    "sym:W_{t}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="W_{t}"];
  }

  // Symbol used in formula (thinned: this is the highest-count, least-traced edge type)
  edge [penwidth=0.4, arrowsize=0.4];
  "sym:C_{raw}" -> "eq:misalignment-growth-condition" [color="#2c528266"];
  "sym:C_{self}" -> "eq:misalignment-growth-condition" [color="#2c528266"];
  "sym:C_{social}" -> "eq:misalignment-growth-condition" [color="#2c528266"];
