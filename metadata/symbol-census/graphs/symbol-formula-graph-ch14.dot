  "sym:C_{value}" -> "eq:misalignment-growth-condition" [color="#2c528266"];
  "sym:C_{world}" -> "eq:misalignment-growth-condition" [color="#2c528266"];
  "sym:C_{power}" -> "eq:alignment-margin" [color="#2c528266"];
  "sym:C_{raw}" -> "eq:alignment-margin" [color="#2c528266"];
  "sym:C_{trans}" -> "eq:alignment-margin" [color="#2c528266"];
