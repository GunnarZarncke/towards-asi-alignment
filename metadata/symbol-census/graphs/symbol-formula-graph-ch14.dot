digraph SymbolFormulaGraph {
  graph [rankdir=LR, fontsize=10, label="Manuscript symbol→formula reachability (ch14)", labelloc=t];
  node [fontname=Helvetica];
  edge [fontname=Helvetica, fontsize=8];

  subgraph cluster_ch14 {
    label="ch14"; style=dashed; color="#92400e";
    "ch14_anchor" [shape=point, width=0.01, label=""];
    "eq:misalignment-growth-condition" [shape=box, style=filled, fillcolor="#d1fae5", label="misalignment\\ngrowth\\ncondition"];
    "ch14_anchor" -> "eq:misalignment-growth-condition" [style=invis];
    "eq:alignment-margin" [shape=box, style=filled, fillcolor="#d1fae5", label="alignment\\nmargin"];
    "ch14_anchor" -> "eq:alignment-margin" [style=invis];
    "eq:power-capacity" [shape=box, style=filled, fillcolor="#d1fae5", label="power\\ncapacity"];
    "ch14_anchor" -> "eq:power-capacity" [style=invis];
    "eq:accelerating-margin-collapse" [shape=box, style=filled, fillcolor="#d1fae5", label="accelerating\\nmargin\\ncollapse"];
    "ch14_anchor" -> "eq:accelerating-margin-collapse" [style=invis];
    "eq:manipulation-index" [shape=box, style=filled, fillcolor="#d1fae5", label="manipulation\\nindex"];
    "ch14_anchor" -> "eq:manipulation-index" [style=invis];
    "eq:successor-certification-condition" [shape=box, style=filled, fillcolor="#d1fae5", label="successor\\ncertification\\ncondition"];
    "ch14_anchor" -> "eq:successor-certification-condition" [style=invis];
    "eq:correction-time-condition" [shape=box, style=filled, fillcolor="#d1fae5", label="correction\\ntime\\ncondition"];
    "ch14_anchor" -> "eq:correction-time-condition" [style=invis];
    "eq:bundle-preservation" [shape=box, style=filled, fillcolor="#d1fae5", label="bundle\\npreservation"];
    "ch14_anchor" -> "eq:bundle-preservation" [style=invis];
    "eq:value-update-process" [shape=box, style=filled, fillcolor="#d1fae5", label="value\\nupdate\\nprocess"];
    "ch14_anchor" -> "eq:value-update-process" [style=invis];
    "eq:admissible-growth" [shape=box, style=filled, fillcolor="#d1fae5", label="admissible\\ngrowth"];
    "ch14_anchor" -> "eq:admissible-growth" [style=invis];
    "eq:expanded-growth-condition" [shape=box, style=filled, fillcolor="#d1fae5", label="expanded\\ngrowth\\ncondition"];
    "ch14_anchor" -> "eq:expanded-growth-condition" [style=invis];
  }

  subgraph cluster_symbols {
    label="Symbols"; style=dotted; color="#2c5282";
    "sym:a_{C}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="a_{C}"];
    "sym:A_{t+1}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="A_{t+1}"];
    "sym:A_{t}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="A_{t}"];
    "sym:a_{T}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="a_{T}"];
    "sym:B" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="B"];
    "sym:B^{(t)}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="B^{(t)}"];
    "sym:B^{(t+1)}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="B^{(t+1)}"];
    "sym:B^{t+1}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="B^{t+1}"];
    "sym:B^{t}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="B^{t}"];
    "sym:C_{power}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="C_{power}"];
    "sym:C_{raw}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="C_{raw}"];
    "sym:C_{self}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="C_{self}"];
    "sym:C_{social}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="C_{social}"];
    "sym:C_{succ}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="C_{succ}"];
    "sym:C_{trans}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="C_{trans}"];
    "sym:C_{value}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="C_{value}"];
    "sym:C_{world}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="C_{world}"];
    "sym:d^{2}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="d^{2}"];
    "sym:d_{bundle}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="d_{bundle}"];
    "sym:D_{t}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="D_{t}"];
    "sym:Delta" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="Delta"];
    "sym:delta" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="delta"];
    "sym:Delta_t_{corr}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="Delta_t_{corr}"];
    "sym:Delta_t_{harm}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="Delta_t_{harm}"];
    "sym:E_{t}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="E_{t}"];
    "sym:epsilon" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="epsilon"];
    "sym:G_{B}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="G_{B}"];
    "sym:J_{t+k}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="J_{t+k}"];
    "sym:M_{A}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="M_{A}"];
    "sym:M_{manip}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="M_{manip}"];
    "sym:MI" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="MI"];
    "sym:MI(·;·)" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="MI(·;·)"];
    "sym:n_{B}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="n_{B}"];
    "sym:P" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="P"];
    "sym:R_{irreversible}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="R_{irreversible}"];
    "sym:r_{p\sim\mathcal{P}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="r_{p\\sim\\mathcal{P}"];
    "sym:S" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="S"];
    "sym:Succ" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="Succ"];
    "sym:t^{2}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="t^{2}"];
    "sym:t_{corr}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="t_{corr}"];
    "sym:t_{harm}" [shape=ellipse, style=filled, fillcolor="#e8f4fc", label="t_{harm}"];
