# Optional override; default token is in site/src/lib/seo.ts
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# PostHog (production builds only; token is public in the static bundle).
# Same phc_ value as repo-root POSTHOG_PROJECT_TOKEN; PUBLIC_ prefix required for Astro.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
