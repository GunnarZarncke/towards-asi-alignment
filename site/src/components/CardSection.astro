---
import Badge from "./Badge.astro";
import ConceptLogo from "./ConceptLogo.astro";
import { badgeStatusHref, badgeTypeHref, type CardStatus, type CardType } from "../lib/badges";
import { GEM_LABEL, badgeGemHref } from "../lib/gems";
import { hasConceptLogo } from "../lib/concept-logos";

interface CardEntry {
  id: string;
  title: string;
  summary: string;
  type: CardType;
  status: CardStatus;
}

interface Props {
  title: string;
  sectionId: string;
  cards: CardEntry[];
  initialCount?: number;
  cardHref: (id: string) => string;
  gemIds?: string[];
}

const { title, sectionId, cards, initialCount = 3, cardHref, gemIds = [] } = Astro.props;
const gemSet = new Set(gemIds);
const hasMore = cards.length > initialCount;
const base = import.meta.env.BASE_URL;
const gemHref = badgeGemHref(base);
---

<section class="card-section" id={sectionId}>
  <h2>{title} <span class="section-count">({cards.length})</span></h2>
  {cards.length === 0 ? (
    <p class="side-panel-meta">None yet.</p>
  ) : (
    <>
      <div class="grid card-section-grid" data-section={sectionId}>
        {cards.map((card, index) => (
          <article
            class:list={["card", "card-section-item", index >= initialCount && "is-collapsed"]}
            data-section={sectionId}
          >
            <div class="badge-row">
              <Badge label={card.type} href={badgeTypeHref(base, card.type)} />
              <Badge label={card.status} variant={card.status} href={badgeStatusHref(base, card.status)} />
              {gemSet.has(card.id) && <Badge label={GEM_LABEL} variant={GEM_LABEL} href={gemHref} />}
            </div>
            <h3>
              <a href={cardHref(card.id)}>
                {card.title}
                {card.type === "concept" && hasConceptLogo(card.id) && (
                  <ConceptLogo slug={card.id} size={40} />
                )}
              </a>
            </h3>
            <p>{card.summary}</p>
          </article>
        ))}
      </div>
      {hasMore && (
        <p>
          <button
            type="button"
            class="button toggle-section"
            data-section={sectionId}
            data-hidden={cards.length - initialCount}
            data-action="expand"
            aria-expanded="false"
          >
            Show {cards.length - initialCount} more
          </button>
        </p>
      )}
    </>
  )}
</section>

<style>
  .section-count {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.92em;
  }

  .card-section-item.is-collapsed {
    display: none;
  }

  .card-section-grid.is-expanded .card-section-item.is-collapsed {
    display: block;
  }

  .toggle-section {
    margin-top: 0.5rem;
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button.toggle-section")) {
    button.addEventListener("click", () => {
      const sectionId = button.dataset.section;
      if (!sectionId) return;
      const grid = document.querySelector<HTMLElement>(`.card-section-grid[data-section="${sectionId}"]`);
      if (!grid) return;

      const expanding = button.dataset.action === "expand";
      grid.classList.toggle("is-expanded", expanding);
      button.dataset.action = expanding ? "collapse" : "expand";
      button.setAttribute("aria-expanded", expanding ? "true" : "false");

      const hidden = button.dataset.hidden || "0";
      button.textContent = expanding ? "Show less" : `Show ${hidden} more`;
    });
  }
</script>
