---
import { readFileSync, existsSync } from "node:fs";
import path from "node:path";
import { hasConceptLogo } from "../lib/concept-logos";

interface Props {
  slug: string;
  size?: number;
  /** When true, size to line height (1em) for inline links. */
  inline?: boolean;
  class?: string;
  /** When false, expose as an image for screen readers via aria-label. */
  decorative?: boolean;
  label?: string;
}

const { slug, size = 48, inline = false, class: className, decorative = true, label } = Astro.props;

if (!hasConceptLogo(slug)) {
  return null;
}

const file = path.join(process.cwd(), "public/concept-logos", `${slug}.svg`);
if (!existsSync(file)) {
  return null;
}

const svg = readFileSync(file, "utf8").replace(/<\?xml[^?]*\?>\s*/i, "").trim();
const ariaLabel = decorative ? undefined : (label ?? `Concept logo: ${slug}`);
---

<span
  class:list={["concept-logo", inline && "concept-logo--inline", className]}
  style={inline ? undefined : `--concept-logo-size: ${size}px`}
  aria-hidden={decorative ? "true" : undefined}
  role={decorative ? undefined : "img"}
  aria-label={ariaLabel}
  set:html={svg}
/>
