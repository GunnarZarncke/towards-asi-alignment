---
interface CoverageColumn {
  id: string;
  short: string;
}

interface CoverageFeature {
  id: string;
  label: string;
  cells: Record<string, string>;
}

interface Props {
  columns: CoverageColumn[];
  features: CoverageFeature[];
  cardHref?: (slug: string) => string;
}

const { columns, features, cardHref } = Astro.props;

const MB_FEATURE_CARDS: Record<string, string> = {
  mb1: "mb1-boundary-estimator-soundness",
  mb2: "mb2-bundle-identifiability",
  mb3: "mb3-bearer-import",
  mb4: "mb4-correction-legitimacy",
  mb5: "mb5-successor-ontology-shift",
  mb6: "mb6-selection-and-basin-stability",
  mb7: "mb7-hidden-capability-and-access",
  mb7d: "mb7-hidden-capability-and-access",
  mb8: "mb8-cev-process-convergence",
  mb9: "mb9-grounding-certificate",
  mb10: "mb10-successor-forgeability"
};

function cellText(value: string) {
  return value.replace(/`/g, "");
}

function featureCardHref(featureId: string) {
  const slug = MB_FEATURE_CARDS[featureId];
  return slug && cardHref ? cardHref(slug) : null;
}
---

<section class="experiment-coverage">
  <h2>Feature coverage</h2>
  <p class="side-panel-meta">
    Rows are book bridges and audit concepts. Columns are experiment lines in build order.
    Cells summarize what each line implements or stress-tests — not every scenario name.
  </p>
  <div class="table-wrap coverage-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">Book feature</th>
          {columns.map((col) => (
            <th scope="col">{col.short}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {features.map((feature) => {
          const href = featureCardHref(feature.id);
          return (
          <tr>
            <th scope="row">
              {href ? <a href={href}>{feature.label}</a> : feature.label}
            </th>
            {columns.map((col) => {
              const value = feature.cells[col.id] ?? "—";
              return <td>{cellText(value)}</td>;
            })}
          </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>

<style>
  .experiment-coverage {
    margin-top: 2rem;
  }

  .coverage-scroll {
    overflow-x: auto;
  }

  .experiment-coverage table {
    font-size: 0.92rem;
  }

  .experiment-coverage th[scope="row"] {
    min-width: 14rem;
    text-align: left;
    vertical-align: top;
  }

  .experiment-coverage th[scope="col"],
  .experiment-coverage td {
    min-width: 7rem;
    vertical-align: top;
  }
</style>
