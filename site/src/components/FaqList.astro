---
import { FAQ_ITEMS, type FaqHref } from "../lib/faq-items";
import LinkIndicator from "./LinkIndicator.astro";
import { cardHref, firstEssayHref, pathHref, pdfHref } from "../lib/site-urls";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

function hrefFor(target: FaqHref): string {
  switch (target.kind) {
    case "route":
      return withBase(target.path);
    case "card":
      return cardHref(base, target.id, target.type);
    case "path":
      return pathHref(base, target.id);
    case "pdf":
      return pdfHref(base);
    case "essay":
      return firstEssayHref(base);
    case "external":
      return target.url;
  }
}
---

<section class="readable">
  {FAQ_ITEMS.map((item) => (
    <details class="card">
      <summary><strong>{item.question}</strong></summary>
      <p>
        {item.answer.map((part) =>
          typeof part === "string" ? (
            part
          ) : part.href.kind === "external" ? (
            <a href={hrefFor(part.href)} target="_blank" rel="noopener noreferrer">
              {part.label}
              {part.href.indicator && <LinkIndicator kind={part.href.indicator} />}
            </a>
          ) : (
            <a href={hrefFor(part.href)}>{part.label}</a>
          )
        )}
      </p>
    </details>
  ))}
</section>
