---
import fieldData from "../data/field-agendas.json";
import { stanceDirectionLabel, stanceMark } from "../lib/field-matrix-cell";
import { cardHref } from "../lib/site-urls";

interface Props {
  base: string;
  showStance?: boolean;
}

const { base, showStance = false } = Astro.props;
const { evidence } = fieldData;

function agendaHref(slug: string) {
  return cardHref(base, `field-agendas/${slug}`);
}

function slugForAgendaName(name: string) {
  const hit = fieldData.agendas.find((a) => a.title === name || a.title.startsWith(name));
  return hit?.slug;
}

function weightStanceForEntry(entry: (typeof evidence)[number]) {
  const direction = entry.direction as string | undefined;
  if (!direction) return "—";
  if (direction === "unclear") return `— ${stanceMark("unclear")}`;
  const weight = entry.weight ?? 1;
  return `${weight} ${stanceMark(direction, weight)}`;
}
---

<section id="coverage-evidence-catalog" class:list={["field-evidence", { "field-evidence--stance": showStance }]}>
  <h2>Evidence catalog</h2>
  <p class="side-panel-meta">
    Primary sources behind matrix tags. External links open in a new tab.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">ID</th>
          <th scope="col">Agenda</th>
          <th scope="col">Bridge</th>
          <th scope="col">Type</th>
          {showStance && (
            <>
              <th scope="col">Direction</th>
              <th scope="col">Weight</th>
            </>
          )}
          <th scope="col">Evidence</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {evidence.map((entry) => {
          const slug = slugForAgendaName(entry.agenda);
          return (
            <tr id={`ev-${entry.id}`}>
              <td>{entry.id}</td>
              <td>
                {slug ? <a href={agendaHref(slug)}>{entry.agenda}</a> : entry.agenda}
              </td>
              <td>{entry.bridges.join(", ")}</td>
              <td>{entry.type}</td>
              {showStance && (
                <>
                  <td>{stanceDirectionLabel(entry.direction as string | undefined)}</td>
                  <td class="stance-weight">{weightStanceForEntry(entry)}</td>
                </>
              )}
              <td>{entry.evidence}</td>
              <td>
                {entry.sources.map((s, i) => (
                  <>
                    {i > 0 && "; "}
                    <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
                  </>
                ))}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  {showStance && (
    <p class="stance-disclaimer side-panel-meta">
      Stance direction and weight on catalog entries were classified by AI-assisted review.
      Treat as editorial heuristics for the field map, not ground-truth verdicts on the sources.
    </p>
  )}
</section>

<style>
  .field-evidence {
    margin-top: 2.5rem;
  }

  .field-evidence table {
    font-size: 0.88rem;
  }

  .field-evidence td,
  .field-evidence th {
    vertical-align: top;
    padding: 0.5rem;
  }

  .field-evidence--stance .stance-weight {
    white-space: nowrap;
    font-size: 1.37rem;
    line-height: 1.2;
  }

  .stance-disclaimer {
    margin: 0.75rem 0 0;
    max-width: 42rem;
    line-height: 1.5;
  }
</style>
