---
import FieldBridgeGraph from "./FieldBridgeGraph.astro";

interface Props {
  base: string;
}

const { base } = Astro.props;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<section id="lens-map" class="bridge-graph-section readable">
  <h2>Criteria map</h2>
  <p class="bridge-graph-lede">
    Default criteria map: nodes are alignment criteria, one lens card each; edge labels open the Lean proof or registry entry on GitHub where one exists.
  </p>
  <FieldBridgeGraph
    title="Alignment criteria"
    svgFile="field-graphs/alignment-frames-relations.svg"
    dotFile="field-graphs/alignment-frames-relations.dot"
    dotSourceUrl="https://github.com/GunnarZarncke/towards-asi-alignment/blob/main/drafts/alignment-frames-relations.dot"
    hint="Click a node for its lens card. Click an edge label for its Lean proof or registry entry on GitHub. Green: compose (not imply). Red and orange: incompatible in a named class; solid rigid, dashed choice conflict, dotted not representable, orange shared resource."
  />
  <p class="side-panel-meta">
    Analysis: <a href="https://github.com/GunnarZarncke/towards-asi-alignment/blob/main/drafts/alignment-frames-relations.md">relations note</a>
    {" · "}
    Lean: <a href="https://github.com/GunnarZarncke/towards-asi-alignment/blob/main/formal/AlignmentProofSpine/FrameRelations.lean">FrameRelations</a>
    {" · "}
    Field cruxes: <a href={withBase("/cards/bridge/bridge-assumptions/#bridge-dependencies")}>bridge dependency map</a>
  </p>
</section>
