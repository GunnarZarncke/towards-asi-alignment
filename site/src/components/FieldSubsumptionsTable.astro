---
import Badge from "./Badge.astro";
import fieldSubsumptions from "../data/field-subsumptions.json";
import fieldSubsumptionGems from "../data/field-subsumption-gems.json";

interface Props {
  cardHref: (slug: string) => string;
  chapterHref: (id: string) => string;
  chapterTitle?: (id: string) => string | null;
  leanHref?: string;
}

const { cardHref, chapterHref, chapterTitle, leanHref } = Astro.props;
const gemSlugs = new Set(fieldSubsumptionGems);
---

<section class="field-subsumptions-table">
  <h2>Field-agenda subsumptions</h2>
  <p class="side-panel-meta">
    Each external alignment agenda maps to a book-facing projection or separation, proved on a shared finite domain in Lean.
    Every row links to a gem card with the subsumption formula, Lean symbol, published work, and book chapters.
    Status ledger and proofs: {leanHref ? <a href={leanHref}>Lean proof spine</a> : "Appendix I (Lean proof spine appendix)"}.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Agenda</th>
          <th>Book-facing claim</th>
          <th>Chapters</th>
        </tr>
      </thead>
      <tbody>
        {fieldSubsumptions.map((row) => (
          <tr>
            <td>
              <a href={cardHref(row.card)}>{row.agenda}</a>
              {gemSlugs.has(row.card) && <Badge label="gem" variant="gem" />}
            </td>
            <td>{row.headline}</td>
            <td>
              {row.chapters.map((chapterId, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={chapterHref(chapterId)}>{chapterTitle?.(chapterId) ?? chapterId}</a>
                </>
              ))}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .field-subsumptions-table {
    margin-top: 2rem;
  }

  .field-subsumptions-table :global(.badge) {
    margin-left: 0.35rem;
    vertical-align: middle;
  }
</style>
