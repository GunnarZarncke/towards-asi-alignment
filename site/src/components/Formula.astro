---
import katex from "katex";

interface Props {
  latex: string;
  explanation: string;
  chapterId?: string;
}

const { latex, explanation, chapterId } = Astro.props;
const rendered = katex.renderToString(latex, {
  throwOnError: false,
  displayMode: true
});
---

<figure class="formula">
  <div class="formula-render" set:html={rendered} />
  <figcaption>
    {explanation}
    {chapterId && <span class="formula-source"> ({chapterId})</span>}
  </figcaption>
</figure>

<style>
  .formula {
    margin: 1.25rem 0;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 6px);
    background: var(--color-surface-muted, var(--color-surface));
    overflow-x: auto;
  }
  .formula-render {
    overflow-x: auto;
  }
  .formula figcaption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .formula-source {
    font-variant: small-caps;
  }
</style>
