---
import FundingStateIcon from "./FundingStateIcon.astro";
import {
  DONE_STATE_LABEL,
  FUNDING_STATE_LABEL,
  type DoneState,
  type FundingState
} from "../lib/funding-state";
---

<div class="graph-legend" aria-label="Graph legend">
  <div class="graph-legend-group">
    <span class="graph-legend-heading">Funding</span>
    <ul class="graph-legend-list">
      {(Object.keys(FUNDING_STATE_LABEL) as FundingState[]).map((state) => (
        <li>
          <FundingStateIcon axis="funding" state={state} />
          <span>{FUNDING_STATE_LABEL[state]}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="graph-legend-group">
    <span class="graph-legend-heading">Implementation</span>
    <ul class="graph-legend-list">
      {(Object.keys(DONE_STATE_LABEL) as DoneState[]).map((state) => (
        <li>
          <FundingStateIcon axis="done" state={state} />
          <span>{DONE_STATE_LABEL[state]}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .graph-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    align-items: flex-start;
    font-size: 0.72rem;
    line-height: 1.3;
  }

  .graph-legend-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
  }

  .graph-legend-heading {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    opacity: 0.7;
  }

  .graph-legend-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.55rem;
  }

  .graph-legend-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .graph-legend-list :global(.funding-icon) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .graph-legend-list :global(.funding-circle),
  .graph-legend-list :global(.done-box) {
    width: 0.7rem;
    height: 0.7rem;
    border-width: 1.5px;
  }
</style>
