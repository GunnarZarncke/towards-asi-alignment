---
import type { DoneState, FundingState } from "../lib/funding-state";

type Props = {
  axis: "funding" | "done";
  state: FundingState | DoneState;
  title?: string;
};

const { axis, state, title } = Astro.props;
---

<span class:list={["funding-icon", axis, state]} title={title} aria-hidden="true">
  {axis === "funding" ? (
    <>
      {state === "open" && <span class="funding-circle open" />}
      {state === "unfunded" && <span class="funding-circle unfunded"><span class="slash" /></span>}
      {state === "partial" && <span class="funding-circle partial" />}
      {state === "funded" && <span class="funding-circle funded" />}
    </>
  ) : (
    <>
      {state === "not_started" && <span class="done-box not_started" />}
      {state === "partial" && <span class="done-box partial" />}
      {state === "done" && <span class="done-box done" />}
    </>
  )}
</span>

<style>
  .funding-icon {
    --funding-icon-fill: var(--color-text, #1a2433);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
    vertical-align: middle;
  }

  .funding-circle {
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    border: 2px solid var(--funding-icon-fill);
    position: relative;
    line-height: 1;
    font-size: 0.65rem;
    text-align: center;
  }

  .funding-circle.partial {
    background: linear-gradient(90deg, var(--funding-icon-fill) 50%, transparent 50%);
  }

  .funding-circle.funded {
    background: var(--funding-icon-fill);
    border-color: var(--funding-icon-fill);
  }

  .funding-circle.unfunded .slash {
    position: absolute;
    inset: 0;
    transform: rotate(-45deg);
  }

  .funding-circle.unfunded .slash::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 10%;
    right: 10%;
    height: 2px;
    background: var(--funding-icon-fill);
    transform: translateY(-50%);
  }

  .done-box {
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
    border: 2px solid var(--funding-icon-fill);
    line-height: 1;
    font-size: 0.65rem;
    text-align: center;
  }

  .done-box.partial {
    background: linear-gradient(90deg, var(--funding-icon-fill) 50%, transparent 50%);
  }

  .done-box.done {
    background: var(--funding-icon-fill);
    border-color: var(--funding-icon-fill);
  }
</style>
