---
import { readFileSync } from "node:fs";
import path from "node:path";

interface Props {
  graphId: string;
  title: string;
  svgFile?: string;
  dotFile?: string;
}

const { graphId, title, svgFile = `lean-graphs/${graphId}.svg`, dotFile } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (assetPath: string) => `${base}${assetPath.replace(/^\/+/, "")}`;

let svgHtml = "";
try {
  svgHtml = readFileSync(path.join(process.cwd(), "public", svgFile), "utf8");
} catch {
  svgHtml =
    '<p class="lean-graph-missing">Graph SVG not found. Run <code>npm run sync</code> in <code>site/</code>.</p>';
}
---

<div class="lean-graph-wrap">
  <p class="lean-graph-hint side-panel-meta">
    Rendered with Graphviz (same sources as the manuscript). Click a node for details; sub-spine boxes (Spine I–IV) open the matching sub-diagram.
    {dotFile && (
      <>
        {" "}
        <a class="lean-graph-dot" href={withBase(dotFile)} download>Graphviz source (.dot)</a>
      </>
    )}
  </p>
  <div class="lean-graph-svg" role="img" aria-label={title} set:html={svgHtml} />
</div>

<style>
  .lean-graph-wrap {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    padding: 0.75rem 0.75rem 1rem;
    overflow-x: auto;
  }

  .lean-graph-hint {
    margin: 0 0 0.65rem;
  }

  .lean-graph-dot {
    white-space: nowrap;
  }

  .lean-graph-svg :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    min-width: 640px;
  }

  .lean-graph-svg :global(a.lean-graph-node) {
    cursor: pointer;
  }

  .lean-graph-svg :global(a.lean-graph-node:hover .node path),
  .lean-graph-svg :global(a.lean-graph-node:hover .node polygon) {
    stroke: var(--color-accent-strong);
    stroke-width: 2.5;
  }

  .lean-graph-missing {
    margin: 0;
    padding: 1rem;
    background: var(--color-warning-bg);
    border: 1px solid var(--color-warning-border);
    border-radius: 8px;
  }
</style>
