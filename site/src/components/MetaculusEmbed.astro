---
interface Props {
  questionId: number;
  title?: string;
}

const { questionId, title = "Metaculus forecast" } = Astro.props;
const src = `https://www.metaculus.com/questions/embed/${questionId}/`;
---

<div class="metaculus-embed-wrap">
  <iframe
    class="metaculus-embed"
    src={src}
    title={title}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  />
</div>

<style>
  .metaculus-embed-wrap {
    margin: 1.25rem 0 1.5rem;
    max-width: 36rem;
    border: 1px solid var(--color-border, #c8d4e0);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-surface, #fff);
  }

  .metaculus-embed {
    display: block;
    width: 100%;
    min-height: 22rem;
    border: none;
  }
</style>
