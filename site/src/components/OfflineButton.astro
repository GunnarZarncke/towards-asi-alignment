---
const serviceWorkerUrl = `${import.meta.env.BASE_URL}sw.js`;
---

<div class="offline-control" data-offline-control data-service-worker-url={serviceWorkerUrl}>
  <button type="button" class="button" data-offline-button>
    Make site available offline
  </button>
  <span class="offline-status" data-offline-status role="status" aria-live="polite">Checking offline status…</span>
</div>

<script>
  const control = document.querySelector<HTMLElement>("[data-offline-control]");
  const button = control?.querySelector<HTMLButtonElement>("[data-offline-button]");
  const status = control?.querySelector<HTMLElement>("[data-offline-status]");

  type OfflineState = {
    type?: string;
    phase?: string;
    completed?: number;
    total?: number;
    enabled?: boolean;
    error?: string | null;
    finished?: boolean;
    caching?: boolean;
    message?: string;
  };

  function counts(state: OfflineState) {
    const completed = state.completed ?? 0;
    const total = state.total ?? 0;
    return total > 0 ? `${completed}/${total}` : null;
  }

  function applyState(state: OfflineState) {
    if (!button || !status) return;
    const count = counts(state);
    const caching = Boolean(state.caching);
    const interrupted = Boolean(state.error) && !caching;
    const complete = Boolean(state.finished) && !interrupted;
    const partial = Boolean(state.enabled) && !complete;

    if (complete) {
      button.disabled = false;
      button.textContent = "Site available offline";
      status.textContent = count
        ? `Offline ready (${count} resources). PDFs and demos were skipped.`
        : "Offline ready. PDFs and demos were skipped.";
      return;
    }

    if (caching) {
      button.disabled = true;
      button.textContent = partial ? "Caching… (partial offline ready)" : "Caching site…";
      const label = state.phase === "pages" ? "pages" : "styles and assets";
      status.textContent = count
        ? `Caching ${label} (${count})…${partial ? " Cached pages are already usable offline." : ""}`
        : "Caching styles and assets…";
      return;
    }

    if (interrupted) {
      button.disabled = false;
      button.textContent = "Continue offline caching";
      const availability = partial
        ? "Partial offline is available."
        : "Partial cache is not yet usable offline.";
      status.textContent = `Interrupted: ${state.error || state.message || "unknown error"}. ${count ? `(${count}) ` : ""}${availability} Click to resume.`;
      return;
    }

    if (partial) {
      button.disabled = false;
      button.textContent = "Continue offline caching";
      status.textContent = count
        ? `Partial offline ready (${count}). Click to continue.`
        : "Partial offline ready. Click to continue.";
      return;
    }

    button.disabled = false;
    button.textContent = "Make site available offline";
    status.textContent = "Not cached for offline use yet.";
  }

  if (control && button && status) {
    if (!("serviceWorker" in navigator)) {
      control.hidden = true;
    } else {
      const serviceWorkerUrl = control.dataset.serviceWorkerUrl;

      navigator.serviceWorker
        .register(serviceWorkerUrl ?? "/sw.js", { updateViaCache: "none" })
        .then((registration) => registration.update())
        .catch((error) => {
          status.textContent = `Offline mode is unavailable: ${error.message}`;
        });

      async function queryOfflineStatus() {
        const registration = await navigator.serviceWorker.ready;
        if (!registration.active) {
          status.textContent = "Waiting for offline support…";
          return;
        }
        registration.active.postMessage({ type: "offline-status" });
      }

      button.addEventListener("click", async () => {
        try {
          const registration = await navigator.serviceWorker.ready;
          if (!registration.active) throw new Error("Service worker is not active yet.");
          button.disabled = true;
          status.textContent = "Starting offline cache…";
          registration.active.postMessage({ type: "cache-site" });
        } catch (error) {
          applyState({
            error: error instanceof Error ? error.message : "Offline caching could not start.",
            caching: false
          });
        }
      });

      navigator.serviceWorker.addEventListener("message", (event) => {
        const data = event.data as OfflineState | undefined;
        if (!data?.type) return;
        if (
          data.type === "offline-status" ||
          data.type === "offline-progress" ||
          data.type === "offline-complete" ||
          data.type === "offline-error"
        ) {
          applyState(data);
        }
      });

      void queryOfflineStatus();
    }
  }
</script>

<style>
  .offline-control {
    display: inline;
  }

  .offline-control .button {
    border: 0;
    padding: 0;
    color: var(--color-accent-strong);
    background: transparent;
    font: inherit;
    font-weight: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .offline-status {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
</style>
