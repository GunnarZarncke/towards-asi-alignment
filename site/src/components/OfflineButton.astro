---
const serviceWorkerUrl = `${import.meta.env.BASE_URL}sw.js`;
---

<div class="offline-control" data-offline-control data-service-worker-url={serviceWorkerUrl}>
  <button type="button" class="button" data-offline-button>
    Make site available offline
  </button>
  <span class="offline-status" data-offline-status role="status" aria-live="polite"></span>
</div>

<script>
  const control = document.querySelector<HTMLElement>("[data-offline-control]");
  const button = control?.querySelector<HTMLButtonElement>("[data-offline-button]");
  const status = control?.querySelector<HTMLElement>("[data-offline-status]");

  function formatProgress(phase: string, completed: number, total: number) {
    const label = phase === "assets" ? "styles and assets" : "pages";
    return `Caching ${label} (${completed}/${total})…`;
  }

  function applyOfflineComplete(completed?: number, total?: number) {
    if (!button || !status) return;
    button.disabled = false;
    button.textContent = "Site available offline";
    if (completed && total) {
      status.textContent = `${completed} of ${total} resources cached. PDFs and demos were skipped.`;
    } else {
      status.textContent = "PDFs and demos are not cached offline.";
    }
  }

  if (control && button && status) {
    if (!("serviceWorker" in navigator)) {
      control.hidden = true;
    } else {
      const serviceWorkerUrl = control.dataset.serviceWorkerUrl;

      navigator.serviceWorker
        .register(serviceWorkerUrl ?? "/sw.js", { updateViaCache: "none" })
        .then((registration) => registration.update())
        .catch((error) => {
          status.textContent = `Offline mode is unavailable: ${error.message}`;
        });

      async function queryOfflineStatus() {
        const registration = await navigator.serviceWorker.ready;
        if (!registration.active) return;
        registration.active.postMessage({ type: "offline-status" });
      }

      button.addEventListener("click", async () => {
        try {
          const registration = await navigator.serviceWorker.ready;
          if (!registration.active) throw new Error("Service worker is not active yet.");
          button.disabled = true;
          status.textContent = "Caching styles and assets…";
          registration.active.postMessage({ type: "cache-site" });
        } catch (error) {
          button.disabled = false;
          status.textContent = error instanceof Error ? error.message : "Offline caching could not start.";
        }
      });

      navigator.serviceWorker.addEventListener("message", (event) => {
        if (event.data?.type === "offline-status") {
          if (event.data.caching && event.data.progress) {
            button.disabled = true;
            status.textContent = formatProgress(
              event.data.progress.phase,
              event.data.progress.completed,
              event.data.progress.total
            );
          } else if (event.data.progress && event.data.progress.completed < event.data.progress.total) {
            button.disabled = false;
            button.textContent = "Continue offline caching";
            status.textContent = `Partial cache (${event.data.progress.completed}/${event.data.progress.total}). Click to resume.`;
          } else if (event.data.enabled) {
            applyOfflineComplete(
              event.data.progress?.completed,
              event.data.progress?.total
            );
          }
          return;
        }
        if (event.data?.type === "offline-progress") {
          button.disabled = true;
          status.textContent = formatProgress(
            event.data.phase,
            event.data.completed,
            event.data.total
          );
        }
        if (event.data?.type === "offline-complete") {
          applyOfflineComplete(event.data.completed, event.data.total);
        }
        if (event.data?.type === "offline-error") {
          button.disabled = false;
          button.textContent = "Continue offline caching";
          status.textContent = `Offline caching interrupted: ${event.data.message}. Click to resume.`;
        }
      });

      void queryOfflineStatus();
    }
  }
</script>

<style>
  .offline-control {
    display: inline;
  }

  .offline-control .button {
    border: 0;
    padding: 0;
    color: var(--color-accent-strong);
    background: transparent;
    font: inherit;
    font-weight: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .offline-status {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
</style>
