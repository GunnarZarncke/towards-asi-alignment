<div class="page-notes" data-page-notes>
  <button
    type="button"
    class="page-notes-trigger"
    aria-label="Open notes"
    aria-expanded="false"
    aria-controls="page-notes-panel"
  >
    ✎
  </button>
  <div
    id="page-notes-panel"
    class="page-notes-overlay"
    hidden
    aria-hidden="true"
    role="dialog"
    aria-label="Page notes"
  >
    <div class="page-notes-panel">
      <div class="page-notes-header">
        <span class="page-notes-title">Notes</span>
        <button
          type="button"
          class="page-notes-expand"
          aria-label="Expand panel"
          aria-pressed="false"
          title="Expand panel"
        >
          ⤢
        </button>
        <button type="button" class="page-notes-close" aria-label="Close notes">✕</button>
      </div>
      <div class="page-notes-editor">
        <textarea
          class="page-notes-input"
          rows="3"
          spellcheck="true"
          aria-label="Note text"
        ></textarea>
        <div class="page-notes-actions">
          <button type="button" class="page-notes-action" data-action="save" title="Save note">✓</button>
          <button type="button" class="page-notes-action" data-action="copy" title="Insert page selection">⎘</button>
          <button type="button" class="page-notes-action" data-action="export" title="Copy all notes">📋</button>
          <button type="button" class="page-notes-action" data-action="download" title="Download all notes">⬇</button>
          <button type="button" class="page-notes-action" data-action="select" title="Select saved note">☰</button>
          <button
            type="button"
            class="page-notes-action page-notes-highlight-trigger"
            data-action="highlight"
            aria-pressed="false"
            title="Toggle note highlights"
          >
            ▦
          </button>
        </div>
      </div>
      <div class="page-notes-select" hidden aria-hidden="true">
        <div class="page-notes-select-header">
          <span>Saved notes</span>
          <button type="button" class="page-notes-select-cancel" aria-label="Cancel selection">✕</button>
        </div>
        <ul class="page-notes-select-list" role="listbox" aria-label="Saved notes"></ul>
      </div>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = "site-page-notes";
  const EXPANDED_STORAGE_KEY = "site-page-notes-expanded";
  const HIGHLIGHT_STORAGE_KEY = "site-page-notes-highlight-mode";
  const HIGHLIGHT_CLASS = "page-notes-highlight";
  const MAIN_SELECTOR = "main.page";

  type SavedNote = { id: string; text: string; path: string };

  type StoredNotes = {
    draft: string;
    notes: SavedNote[];
  };

  function currentPath(): string {
    return window.location.pathname;
  }

  function noteFirstLine(text: string): string {
    return text.split("\n").find((line) => line.trim())?.trim() ?? "";
  }

  function notePageUrl(note: SavedNote, withFragment = true): string {
    const path = note.path || "/";
    const base = `${window.location.origin}${path.startsWith("/") ? path : `/${path}`}`;
    if (!withFragment) return base;
    const fragment = noteFirstLine(note.text);
    if (!fragment) return base;
    const snippet = fragment.slice(0, 120);
    return `${base}#:~:text=${encodeURIComponent(snippet)}`;
  }

  function normalizeNote(raw: unknown): SavedNote | null {
    if (!raw || typeof raw !== "object") return null;
    const item = raw as Partial<SavedNote>;
    if (typeof item.id !== "string" || typeof item.text !== "string") return null;
    return {
      id: item.id,
      text: item.text,
      path: typeof item.path === "string" ? item.path : ""
    };
  }

  function loadStored(): StoredNotes {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return { draft: "", notes: [] };
      const parsed = JSON.parse(raw) as Partial<StoredNotes>;
      return {
        draft: typeof parsed.draft === "string" ? parsed.draft : "",
        notes: Array.isArray(parsed.notes)
          ? parsed.notes.map(normalizeNote).filter((n): n is SavedNote => n !== null)
          : []
      };
    } catch {
      return { draft: "", notes: [] };
    }
  }

  function saveStored(data: StoredNotes) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {
      /* ignore quota / private mode */
    }
  }

  function getPageSelection(): string {
    return window.getSelection()?.toString() ?? "";
  }

  function ensureTrailingNewline(text: string): string {
    if (!text) return text;
    return text.endsWith("\n") ? text : `${text}\n`;
  }

  function isExpanded(): boolean {
    return panel.classList.contains("is-expanded");
  }

  function loadExpanded(): boolean {
    try {
      return localStorage.getItem(EXPANDED_STORAGE_KEY) === "true";
    } catch {
      return false;
    }
  }

  function setExpanded(expanded: boolean) {
    panel.classList.toggle("is-expanded", expanded);
    try {
      localStorage.setItem(EXPANDED_STORAGE_KEY, expanded ? "true" : "false");
    } catch {
      /* ignore quota / private mode */
    }
    syncExpandButton();
  }

  function syncExpandButton() {
    const expanded = isExpanded();
    expandBtn.setAttribute("aria-pressed", expanded ? "true" : "false");
    expandBtn.setAttribute("aria-label", expanded ? "Collapse panel" : "Expand panel");
    expandBtn.title = expanded ? "Collapse panel" : "Expand panel";
    expandBtn.textContent = expanded ? "⤡" : "⤢";
  }

  function insertAtCursor(textarea: HTMLTextAreaElement, text: string) {
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const value = textarea.value;
    textarea.value = value.slice(0, start) + text + value.slice(end);
    const cursor = start + text.length;
    textarea.selectionStart = cursor;
    textarea.selectionEnd = cursor;
  }

  function notesExportText(notes: SavedNote[]): string {
    return notes
      .map((note) => {
        const url = notePageUrl(note);
        return `${url}\n${note.text}`;
      })
      .join("\n\n");
  }

  function downloadText(filename: string, text: string) {
    const blob = new Blob([text], { type: "text/plain;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = filename;
    anchor.click();
    URL.revokeObjectURL(url);
  }

  async function copyToClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  function newNoteId(): string {
    return crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`;
  }

  const root = document.querySelector<HTMLElement>("[data-page-notes]");
  const highlightTrigger = root?.querySelector<HTMLButtonElement>(".page-notes-highlight-trigger");
  const trigger = root?.querySelector<HTMLButtonElement>(".page-notes-trigger");
  const overlay = root?.querySelector<HTMLElement>(".page-notes-overlay");
  const panel = root?.querySelector<HTMLElement>(".page-notes-panel");
  const closeBtn = root?.querySelector<HTMLButtonElement>(".page-notes-close");
  const expandBtn = root?.querySelector<HTMLButtonElement>(".page-notes-expand");
  const input = root?.querySelector<HTMLTextAreaElement>(".page-notes-input");
  const selectPane = root?.querySelector<HTMLElement>(".page-notes-select");
  const selectList = root?.querySelector<HTMLUListElement>(".page-notes-select-list");
  const selectCancel = root?.querySelector<HTMLButtonElement>(".page-notes-select-cancel");
  const actionButtons = root?.querySelectorAll<HTMLButtonElement>("[data-action]");

  if (
    !root ||
    !highlightTrigger ||
    !trigger ||
    !overlay ||
    !panel ||
    !closeBtn ||
    !expandBtn ||
    !input ||
    !selectPane ||
    !selectList ||
    !selectCancel
  ) {
    throw new Error("Page notes markup missing");
  }

  // Keep the full-screen overlay out of the fixed FAB cluster so mobile browsers
  // don't clip it to the corner button box.
  document.body.appendChild(overlay);

  setExpanded(loadExpanded());

  let stored = loadStored();
  let currentNoteId: string | null = null;
  let draftBuffer: string | null = null;
  let highlightMode = loadHighlightMode();

  function loadHighlightMode(): boolean {
    try {
      return localStorage.getItem(HIGHLIGHT_STORAGE_KEY) === "true";
    } catch {
      return false;
    }
  }

  function setHighlightMode(enabled: boolean) {
    highlightMode = enabled;
    try {
      localStorage.setItem(HIGHLIGHT_STORAGE_KEY, enabled ? "true" : "false");
    } catch {
      /* ignore quota / private mode */
    }
    syncHighlightButton();
    if (enabled) applyHighlights();
    else clearHighlights();
  }

  function syncHighlightButton() {
    highlightTrigger.setAttribute("aria-pressed", highlightMode ? "true" : "false");
    highlightTrigger.setAttribute(
      "aria-label",
      highlightMode ? "Turn off note highlights on this page" : "Turn on note highlights on this page"
    );
    highlightTrigger.title = highlightMode ? "Turn off note highlights" : "Turn on note highlights";
    highlightTrigger.classList.toggle("is-active", highlightMode);
  }

  function notesForCurrentPage(): SavedNote[] {
    const path = currentPath();
    return stored.notes.filter((note) => note.path === path);
  }

  function clearHighlights() {
    document.querySelectorAll(`mark.${HIGHLIGHT_CLASS}`).forEach((mark) => {
      const parent = mark.parentNode;
      if (!parent) return;
      parent.replaceChild(document.createTextNode(mark.textContent ?? ""), mark);
      parent.normalize();
    });
  }

  function highlightTextInElement(rootEl: Element, search: string, note: SavedNote) {
    const walker = document.createTreeWalker(rootEl, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        const parent = node.parentElement;
        if (!parent) return NodeFilter.FILTER_REJECT;
        if (parent.closest("[data-page-notes], .site-header, .site-footer, script, style, noscript")) {
          return NodeFilter.FILTER_REJECT;
        }
        if (parent.closest(`mark.${HIGHLIGHT_CLASS}`)) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });

    const textNodes: Text[] = [];
    let node: Node | null;
    while ((node = walker.nextNode())) textNodes.push(node as Text);

    for (const textNode of textNodes) {
      const text = textNode.data;
      const idx = text.indexOf(search);
      if (idx === -1) continue;

      const before = text.slice(0, idx);
      const match = text.slice(idx, idx + search.length);
      const after = text.slice(idx + search.length);

      const mark = document.createElement("mark");
      mark.className = HIGHLIGHT_CLASS;
      mark.dataset.noteId = note.id;
      mark.title = note.text;

      const frag = document.createDocumentFragment();
      if (before) frag.appendChild(document.createTextNode(before));
      mark.textContent = match;
      frag.appendChild(mark);
      if (after) frag.appendChild(document.createTextNode(after));
      textNode.parentNode?.replaceChild(frag, textNode);
      return;
    }
  }

  function applyHighlights() {
    clearHighlights();
    if (!highlightMode) return;
    const main = document.querySelector(MAIN_SELECTOR);
    if (!main) return;

    const targets = notesForCurrentPage()
      .map((note) => ({ note, search: noteFirstLine(note.text) }))
      .filter(({ search }) => search.length >= 3)
      .sort((a, b) => b.search.length - a.search.length);

    for (const { note, search } of targets) {
      highlightTextInElement(main, search, note);
    }
  }

  syncHighlightButton();
  if (highlightMode) applyHighlights();

  function persistDraft() {
    stored.draft = input.value;
    saveStored(stored);
  }

  function isEditing(): boolean {
    return currentNoteId !== null;
  }

  function cancelEdit() {
    if (draftBuffer !== null) {
      input.value = draftBuffer;
      draftBuffer = null;
    }
    currentNoteId = null;
    hideSelectPane();
  }

  function hideSelectPane() {
    selectPane.hidden = true;
    selectPane.setAttribute("aria-hidden", "true");
  }

  function showSelectPane() {
    selectPane.hidden = false;
    selectPane.setAttribute("aria-hidden", "false");
  }

  function renderSelectList() {
    selectList.replaceChildren();
    if (stored.notes.length === 0) {
      const empty = document.createElement("li");
      empty.className = "page-notes-select-empty";
      empty.textContent = "No saved notes yet.";
      selectList.append(empty);
      return;
    }
    for (const note of stored.notes) {
      const item = document.createElement("li");
      item.className = "page-notes-select-item";
      if (note.id === currentNoteId) item.classList.add("is-active");
      item.setAttribute("role", "option");
      item.tabIndex = 0;

      const body = document.createElement("div");
      body.className = "page-notes-select-body";

      const preview = document.createElement("div");
      preview.className = "page-notes-select-preview";
      const previewText =
        note.text.length > 120 ? `${note.text.slice(0, 117).trimEnd()}…` : note.text;
      preview.textContent = previewText || "(empty note)";
      preview.title = note.text;

      const pathLink = document.createElement("a");
      pathLink.className = "page-notes-select-path";
      pathLink.href = notePageUrl(note);
      pathLink.textContent = note.path || "/";
      pathLink.title = "Open page and highlight quoted text";
      pathLink.addEventListener("click", (event) => event.stopPropagation());

      body.append(preview, pathLink);
      item.append(body);

      item.addEventListener("click", () => chooseNote(note.id));
      item.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          chooseNote(note.id);
        }
      });
      selectList.append(item);
    }
  }

  function chooseNote(id: string) {
    if (currentNoteId === id) {
      hideSelectPane();
      return;
    }
    if (isEditing()) cancelEdit();
    draftBuffer = input.value;
    const note = stored.notes.find((n) => n.id === id);
    if (!note) return;
    input.value = note.text;
    currentNoteId = id;
    hideSelectPane();
    input.focus();
  }

  function saveNote() {
    const text = input.value;
    if (!text.trim() && !isEditing()) return;

    if (currentNoteId) {
      const idx = stored.notes.findIndex((n) => n.id === currentNoteId);
      if (idx >= 0) {
        const existing = stored.notes[idx];
        if (text.trim()) {
          stored.notes[idx] = {
            id: currentNoteId,
            text,
            path: existing.path || currentPath()
          };
        } else {
          stored.notes.splice(idx, 1);
        }
      }
    } else if (text.trim()) {
      stored.notes.push({ id: newNoteId(), text, path: currentPath() });
    }

    if (draftBuffer !== null) {
      input.value = draftBuffer;
      draftBuffer = null;
    } else {
      input.value = "";
    }
    currentNoteId = null;
    stored.draft = input.value;
    saveStored(stored);
    hideSelectPane();
    if (highlightMode) applyHighlights();
    input.focus();
  }

  function open() {
    input.value = stored.draft;
    currentNoteId = null;
    draftBuffer = null;
    hideSelectPane();

    if (!input.value.trim()) {
      const selection = getPageSelection().trim();
      if (selection) input.value = ensureTrailingNewline(selection);
    }

    overlay.hidden = false;
    overlay.setAttribute("aria-hidden", "false");
    trigger.setAttribute("aria-expanded", "true");
    trigger.classList.add("is-open");
    syncOverlayLayout();
    requestAnimationFrame(() => {
      syncOverlayLayout();
      input.focus({ preventScroll: true });
    });
  }

  function close() {
    if (isEditing()) cancelEdit();
    persistDraft();
    hideSelectPane();
    overlay.hidden = true;
    overlay.setAttribute("aria-hidden", "true");
    trigger.setAttribute("aria-expanded", "false");
    trigger.classList.remove("is-open");
    resetOverlayLayout();
  }

  function resetOverlayLayout() {
    overlay.style.top = "";
    overlay.style.left = "";
    overlay.style.right = "";
    overlay.style.bottom = "";
    overlay.style.width = "";
    overlay.style.height = "";
    overlay.style.padding = "";
    panel.style.maxHeight = "";
  }

  function isMobileLayout(): boolean {
    return window.matchMedia("(max-width: 760px)").matches;
  }

  function syncOverlayLayout() {
    if (overlay.hidden) return;
    const vv = window.visualViewport;
    if (!vv) return;

    const edgeGap = 12;
    const keyboardOpen = window.innerHeight - vv.height - vv.offsetTop > 80;
    const useVisualViewport = isMobileLayout() || keyboardOpen;

    if (useVisualViewport) {
      overlay.style.top = `${vv.offsetTop}px`;
      overlay.style.left = `${vv.offsetLeft}px`;
      overlay.style.right = "auto";
      overlay.style.bottom = "auto";
      overlay.style.width = `${vv.width}px`;
      overlay.style.height = `${vv.height}px`;
      overlay.style.padding = `${edgeGap}px`;

      const available = vv.height - edgeGap * 2;
      const expanded = isExpanded();
      const preferred = expanded ? available * 0.6 : Math.min(available * 0.7, 512);
      panel.style.maxHeight = `${Math.max(140, Math.min(preferred, available))}px`;
      return;
    }

    resetOverlayLayout();
  }

  trigger.addEventListener("click", (event) => {
    event.stopPropagation();
    if (overlay.hidden) open();
    else close();
  });

  closeBtn.addEventListener("click", (event) => {
    event.stopPropagation();
    close();
  });

  expandBtn.addEventListener("click", (event) => {
    event.stopPropagation();
    setExpanded(!isExpanded());
    syncOverlayLayout();
    input.focus();
  });

  panel.addEventListener("click", (event) => event.stopPropagation());
  overlay.addEventListener("click", close);

  selectCancel.addEventListener("click", (event) => {
    event.stopPropagation();
    if (isEditing()) cancelEdit();
    hideSelectPane();
    input.focus();
  });

  input.addEventListener("input", persistDraft);
  input.addEventListener("focus", syncOverlayLayout);

  window.visualViewport?.addEventListener("resize", syncOverlayLayout);
  window.visualViewport?.addEventListener("scroll", syncOverlayLayout);

  actionButtons?.forEach((button) => {
    button.addEventListener("click", async (event) => {
      event.stopPropagation();
      const action = button.dataset.action;
      if (action === "save") {
        saveNote();
        return;
      }
      if (action === "copy") {
        const selection = getPageSelection();
        if (selection) insertAtCursor(input, ensureTrailingNewline(selection));
        persistDraft();
        input.focus();
        return;
      }
      if (action === "export") {
        if (stored.notes.length === 0) return;
        await copyToClipboard(notesExportText(stored.notes));
        return;
      }
      if (action === "download") {
        if (stored.notes.length === 0) return;
        downloadText("page-notes.txt", notesExportText(stored.notes));
        return;
      }
      if (action === "select") {
        renderSelectList();
        showSelectPane();
        return;
      }
      if (action === "highlight") {
        setHighlightMode(!highlightMode);
        return;
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !overlay.hidden) {
      if (!selectPane.hidden) {
        if (isEditing()) cancelEdit();
        hideSelectPane();
        event.stopPropagation();
        return;
      }
      close();
    }
  });
</script>

<style>
  .page-notes-trigger {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--color-muted);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    cursor: pointer;
  }

  .page-notes-trigger:hover,
  .page-notes-trigger.is-open {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
  }

  :global(mark.page-notes-highlight) {
    background: #fef08a;
    color: inherit;
    cursor: help;
    border-radius: 0.15rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .page-notes-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: max(0.75rem, env(safe-area-inset-top, 0px)) max(0.75rem, env(safe-area-inset-right, 0px))
      max(0.75rem, env(safe-area-inset-bottom, 0px)) max(0.75rem, env(safe-area-inset-left, 0px));
    background: rgba(15, 23, 42, 0.35);
    box-sizing: border-box;
  }

  .page-notes-overlay[hidden] {
    display: none;
  }

  .page-notes-panel {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: min(80ch, 100%);
    max-width: 100%;
    max-height: min(70vh, 32rem);
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    box-sizing: border-box;
  }

  .page-notes-panel.is-expanded {
    height: 60vh;
    max-height: 60vh;
  }

  .page-notes-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
  }

  .page-notes-title {
    justify-self: start;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .page-notes-expand {
    justify-self: center;
    border: 1px solid var(--color-border);
    border-radius: 0.45rem;
    padding: 0.15rem 0.45rem;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--color-muted);
    background: var(--color-surface);
    cursor: pointer;
  }

  .page-notes-expand:hover,
  .page-notes-expand[aria-pressed="true"] {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
  }

  .page-notes-close {
    justify-self: end;
    border: 0;
    padding: 0.15rem 0.35rem;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--color-muted);
    background: transparent;
    cursor: pointer;
  }

  .page-notes-close:hover {
    color: var(--color-accent-strong);
  }

  .page-notes-editor {
    position: relative;
    flex-shrink: 0;
    padding-bottom: 1.1rem;
  }

  .page-notes-input {
    width: 100%;
    min-height: calc(3 * 1.45em + 0.75rem);
    max-height: 12rem;
    margin: 0;
    padding: 0.45rem 0.55rem 2rem;
    border: 1px solid var(--color-border);
    border-radius: 0.45rem;
    resize: vertical;
    overflow: auto;
    font: inherit;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-text);
    background: var(--color-surface-muted);
    box-sizing: border-box;
  }

  .page-notes-panel.is-expanded .page-notes-input {
    flex: 1;
    min-height: 0;
    max-height: none;
    resize: none;
  }

  .page-notes-panel.is-expanded .page-notes-select-list {
    flex: 1;
    max-height: none;
  }

  .page-notes-input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .page-notes-actions {
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    transform: translateY(50%);
    z-index: 2;
  }

  .page-notes-action {
    border: 1px solid var(--color-border);
    border-radius: 0.45rem;
    padding: 0.3rem 0.55rem;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
