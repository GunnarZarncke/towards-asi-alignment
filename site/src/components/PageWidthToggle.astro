<div class="page-width-toggle" data-page-width-toggle>
  <button
    type="button"
    class="page-width-toggle-trigger"
    aria-label="Switch to full-width layout"
    aria-pressed="false"
    data-layout-mode="standard"
  >
    &lt;-&gt;
  </button>
</div>

<script>
  import {
    applyLayoutMode,
    cycleLayoutMode,
    layoutModeLabel,
    layoutModeNextAction,
    persistLayoutMode,
    readStoredLayoutMode,
    type LayoutMode
  } from "../lib/site-layout-mode";

  function syncButton(mode: LayoutMode) {
    const trigger = document.querySelector<HTMLButtonElement>(".page-width-toggle-trigger");
    if (!trigger) return;
    trigger.setAttribute("aria-pressed", mode === "standard" ? "false" : "true");
    trigger.setAttribute("aria-label", layoutModeNextAction(mode));
    trigger.setAttribute("title", layoutModeLabel(mode));
    trigger.dataset.layoutMode = mode;
  }

  function setLayoutMode(mode: LayoutMode) {
    applyLayoutMode(mode);
    persistLayoutMode(mode);
    syncButton(mode);
  }

  const trigger = document.querySelector<HTMLButtonElement>(".page-width-toggle-trigger");
  if (!trigger) throw new Error("Page width toggle markup missing");

  const initialMode = readStoredLayoutMode();
  applyLayoutMode(initialMode);
  syncButton(initialMode);

  trigger.addEventListener("click", (event) => {
    event.stopPropagation();
    const current = readStoredLayoutMode();
    setLayoutMode(cycleLayoutMode(current));
  });
</script>

<style>
  .page-width-toggle-trigger {
    position: fixed;
    left: max(0.75rem, env(safe-area-inset-left, 0px));
    bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
    z-index: 40;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    cursor: pointer;
  }

  .page-width-toggle-trigger:hover,
  .page-width-toggle-trigger[aria-pressed="true"] {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
  }
</style>
