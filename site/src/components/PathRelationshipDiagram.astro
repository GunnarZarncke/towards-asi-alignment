---
import { pathHref } from "../lib/site-urls";
import { PATH_LABELS } from "../lib/path-order";

interface PathEntry {
  id: string;
  title: string;
}

interface Props {
  paths: PathEntry[];
  base: string;
}

const { paths, base } = Astro.props;

const pathById = new Map(paths.map((path) => [path.id, path]));

const labelFor = (id: string) => {
  const path = pathById.get(id);
  if (path) return path.title.replace(/ Path$/, "");
  return PATH_LABELS[id as keyof typeof PATH_LABELS] ?? id;
};

const hrefFor = (id: string) => pathHref(base, id);

const branchIds = ["generalist", "philosopher", "funder-policy"];
const sequenceIds = ["researcher-applied", "researcher-formal"];
---

<div class="path-flow">
  <div class="path-node path-node-center">New reader</div>
  <div class="path-row">
    {branchIds.map((id) => (
      <a class="path-node" href={hrefFor(id)}>{labelFor(id)}</a>
    ))}
  </div>
  <div class="path-row">
    <a class="path-node" href={hrefFor(sequenceIds[0])}>{labelFor(sequenceIds[0])}</a>
    <span class="path-arrow" aria-hidden="true">→</span>
    <a class="path-node" href={hrefFor(sequenceIds[1])}>{labelFor(sequenceIds[1])}</a>
  </div>
  <div class="path-row">
    <a class="path-node" href={hrefFor("engineer-evals")}>{labelFor("engineer-evals")}</a>
    <span class="path-note">often pairs with Appendix D worked example</span>
  </div>
</div>

<style>
  .path-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem 0;
    font-size: 0.92rem;
  }

  .path-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
  }

  .path-node {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.45rem 0.75rem;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
  }

  a.path-node:hover {
    border-color: var(--color-accent-strong);
  }

  .path-node-center {
    font-weight: 600;
    background: var(--color-open-bg);
  }

  .path-arrow {
    opacity: 0.6;
  }

  .path-note {
    font-size: 0.85rem;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
