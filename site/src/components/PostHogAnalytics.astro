---
/** Product analytics (optional). Token is public; set at build time via PUBLIC_POSTHOG_* */
const token = import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN?.trim() || "";
const enabled = !import.meta.env.DEV && Boolean(token);
---

{
  enabled && (
    <script>
      import posthog from "posthog-js";
      import { pageviewProperties, shouldRecordVisit } from "../lib/page-visit";

      const token = import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN?.trim() || "";
      const host =
        import.meta.env.PUBLIC_POSTHOG_HOST?.trim() || "https://eu.i.posthog.com";

      posthog.init(token, {
        api_host: host,
        person_profiles: "identified_only",
        // Recorded on pageshow below, including when the service worker
        // shows a cached document and does not refetch it.
        capture_pageview: false,
        capture_pageleave: true,
        autocapture: false,
        disable_session_recording: true,
        capture_exceptions: {
          capture_unhandled_errors: true,
          capture_unhandled_rejections: true,
          capture_console_errors: false,
        },
      });
      posthog.register({ app: "companion_site" });

      function recordVisit(restored: boolean) {
        if (!shouldRecordVisit(location.search)) return;
        const send = () => {
          const navigation = performance.getEntriesByType("navigation")[0] as
            | PerformanceNavigationTiming
            | undefined;
          posthog.capture(
            "$pageview",
            pageviewProperties({
              title: document.title,
              restored,
              navigation
            }),
            { send_instantly: true }
          );
        };
        if (document.visibilityState === "visible") {
          send();
          return;
        }
        const onVisible = () => {
          if (document.visibilityState !== "visible") return;
          document.removeEventListener("visibilitychange", onVisible);
          send();
        };
        document.addEventListener("visibilitychange", onVisible);
      }

      window.addEventListener("pageshow", (event) => {
        recordVisit(event.persisted);
      });
    </script>
  )
}
