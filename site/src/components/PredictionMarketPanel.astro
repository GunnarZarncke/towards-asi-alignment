---
import MetaculusEmbed from "./MetaculusEmbed.astro";

interface Props {
  shortTitle: string;
  href: string;
  number?: number;
  listingStatus?: string;
  listingLabel?: string;
  embedId?: number;
  note?: string;
  badge?: "external" | "related";
  externalLink?: boolean;
}

const {
  number,
  shortTitle,
  href,
  listingStatus,
  listingLabel,
  embedId,
  note,
  badge,
  externalLink = false
} = Astro.props;
---

<article class="market-panel">
  <h3 class="market-panel-title">
    <a href={href} target={externalLink ? "_blank" : undefined} rel={externalLink ? "noopener noreferrer" : undefined}>
      {number != null && <span class="market-num">{number}.</span>}
      {shortTitle}
    </a>
    {
      badge === "external" && <span class="forecast-badge external-badge">External</span>
    }
    {
      badge === "related" && <span class="forecast-badge related-badge">Related</span>
    }
    {
      listingStatus && listingLabel && (
        <span class:list={["listing-status", `listing-status-${listingStatus}`]}>{listingLabel}</span>
      )
    }
  </h3>
  {note && <p class="market-panel-note">{note}</p>}
  {
    embedId ? (
      <MetaculusEmbed questionId={embedId} title={shortTitle} layout="panel" />
    ) : (
      <div class="forecast-slot" aria-hidden="true">
        <p>Forecast appears here when this market is listed on Metaculus.</p>
      </div>
    )
  }
</article>

<style>
  .market-panel {
    display: flex;
    flex-direction: column;
    margin: 0;
    width: 100%;
    min-width: 0;
    height: 100%;
    padding: 1rem 1rem 1.1rem;
    border: 1px solid var(--color-border, #c8d4e0);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-surface) 96%, #fff);
  }

  .market-panel-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .market-panel-title a {
    text-decoration: none;
    color: inherit;
  }

  .market-panel-title a:hover {
    text-decoration: underline;
  }

  .market-num {
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  .market-panel-note {
    margin: -0.35rem 0 0.75rem;
    font-size: 0.92rem;
    line-height: 1.45;
    opacity: 0.88;
  }

  .forecast-badge {
    display: inline-block;
    padding: 0.08rem 0.38rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .external-badge {
    border: 1px solid color-mix(in srgb, #c2410c 42%, transparent);
    color: color-mix(in srgb, #c2410c 82%, var(--color-text));
    background: color-mix(in srgb, #c2410c 7%, transparent);
  }

  .related-badge {
    border: 1px solid color-mix(in srgb, var(--color-text) 24%, transparent);
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .listing-status {
    display: inline-block;
    padding: 0.08rem 0.38rem;
    border: 1px solid color-mix(in srgb, var(--color-text) 24%, transparent);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
  }

  .listing-status-funding-gated {
    border-color: color-mix(in srgb, #c2410c 42%, transparent);
    color: color-mix(in srgb, #c2410c 82%, var(--color-text));
    background: color-mix(in srgb, #c2410c 7%, transparent);
  }

  .forecast-slot {
    flex: 1 1 auto;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 15rem;
    padding: 1rem;
    border: 1px dashed color-mix(in srgb, var(--color-text) 22%, transparent);
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--color-surface) 92%, #e8eef4);
  }

  .forecast-slot p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.4;
    opacity: 0.75;
    text-align: center;
  }
</style>
