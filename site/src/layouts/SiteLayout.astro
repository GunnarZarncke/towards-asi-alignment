---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import CloudflareWebAnalytics from "../components/CloudflareWebAnalytics.astro";
import PageQrCode from "../components/PageQrCode.astro";
import SiteSearch from "../components/SiteSearch.astro";
import { pdfHref } from "../lib/site-urls";
import {
  AUTHOR_NAME,
  DEFAULT_DESCRIPTION,
  LLMS_TXT_URL,
  OG_IMAGE_ALT,
  OG_IMAGE_URL,
  SEARCH_INDEX_JSON_URL,
  SITE_NAME,
  absoluteSiteUrl,
  pageTitle as buildPageTitle,
  truncateDescription
} from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  /** When true, emit noindex (e.g. draft or utility pages). */
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Override default social preview image (absolute URL). */
  ogImage?: string;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  noindex = false,
  ogType = "website",
  ogImage = OG_IMAGE_URL
} = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const siteOrigin = Astro.site?.origin ?? "https://towards-alignment.com";
const pageTitle = buildPageTitle(title);
const canonicalUrl = absoluteSiteUrl(Astro.url.pathname, siteOrigin);
const metaDescription = truncateDescription(description);
const pdfUrl = pdfHref(base);
const robots = noindex ? "noindex, follow" : "index, follow";
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: siteOrigin,
  description: DEFAULT_DESCRIPTION,
  author: { "@type": "Person", name: AUTHOR_NAME },
  publisher: { "@type": "Organization", name: SITE_NAME }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content={AUTHOR_NAME} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href={LLMS_TXT_URL} title="LLM / agent orientation (llms.txt)" />
    <link rel="alternate" type="application/json" href={SEARCH_INDEX_JSON_URL} title="Site search index" />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <div class="site-header-inner">
          <a class="brand" href={withBase("/")}>{SITE_NAME}</a>
          <nav class="nav" aria-label="Primary navigation">
            <a href={withBase("/")}>Start Here</a>
            <a href={withBase("/paths/")}>Guided Tour</a>
            <a href={withBase("/cards/")}>Cards</a>
            <a href={withBase("/badges/")}>Badges</a>
            <a href={withBase("/faq/")}>FAQ</a>
            <a href={withBase("/book/")}>Book</a>
            <a href={withBase("/lean/")}>Lean</a>
            <a href={withBase("/experiments/")}>Experiments</a>
            <a href={withBase("/demos/")}>Demos</a>
            <a href={withBase("/references/")}>References</a>
            <a href={withBase("/about/")}>About</a>
            <a href={withBase("/updates/")}>Updates</a>
            <a href={pdfUrl}>PDF</a>
            <SiteSearch />
          </nav>
        </div>
      </header>
      <main class="page">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer-inner">
          <p>
            A static companion site for an authored research manuscript.
          </p>
          <p>
            <a href="https://github.com/GunnarZarncke/towards-asi-alignment">GitHub repository</a> ·
            <a href="https://github.com/GunnarZarncke/towards-asi-alignment/issues">Discussion via GitHub issues</a> ·
            <a href={withBase("/updates/")}>Updates</a> ·
            <a href={withBase("/impressum/")}>Impressum</a>
          </p>
        </div>
      </footer>
    </div>
    <PageQrCode url={canonicalUrl} />
    <CloudflareWebAnalytics />
  </body>
</html>
