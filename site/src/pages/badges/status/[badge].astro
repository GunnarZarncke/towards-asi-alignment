---
import { getCollection } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import Badge from "../../../components/Badge.astro";
import {
  CARD_STATUSES,
  STATUS_META,
  badgeStatusHref,
  badgeTypeHref,
  type CardStatus
} from "../../../lib/badges";
import { cardHref } from "../../../lib/site-urls";

export async function getStaticPaths() {
  return CARD_STATUSES.map((badge) => ({
    params: { badge },
    props: { badge }
  }));
}

const { badge } = Astro.props as { badge: CardStatus };
const meta = STATUS_META[badge];
const cards = await getCollection("cards");
const matching = cards
  .filter((card) => card.data.status === badge)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<SiteLayout title={`${meta.title} status`} description={meta.description}>
  <section class="hero">
    <p class="eyebrow"><a href={withBase("/badges/")}>Badge index</a></p>
    <div class="badge-row">
      <Badge label={badge} variant={badge} />
    </div>
    <h1>{meta.title} status</h1>
    <p class="lede">{meta.description}</p>
    <p class="side-panel-meta">{matching.length} card{matching.length === 1 ? "" : "s"}</p>
  </section>

  <section>
    {matching.length === 0 ? (
      <p class="side-panel-meta">No cards with this status yet.</p>
    ) : (
      <div class="grid">
        {matching.map((card) => (
          <article class="card">
            <div class="badge-row">
              <Badge label={card.data.type} href={badgeTypeHref(base, card.data.type)} />
              <Badge label={card.data.status} variant={card.data.status} href={badgeStatusHref(base, card.data.status)} />
            </div>
            <h2><a href={cardHref(base, card.id)}>{card.data.title}</a></h2>
            <p>{card.data.summary}</p>
          </article>
        ))}
      </div>
    )}
  </section>

  <section>
    <p><a href={withBase("/badges/")}>All badges</a> · <a href={withBase("/cards/")}>All cards</a></p>
  </section>
</SiteLayout>
