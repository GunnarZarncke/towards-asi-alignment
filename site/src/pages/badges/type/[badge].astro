---
import { getCollection } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import Badge from "../../../components/Badge.astro";
import ConceptCardLink from "../../../components/ConceptCardLink.astro";
import {
  CARD_TYPES,
  TYPE_META,
  badgeTypeHref,
  badgesIndexHref,
  type CardType
} from "../../../lib/badges";
import { cardHref } from "../../../lib/site-urls";

export async function getStaticPaths() {
  return CARD_TYPES.map((badge) => ({
    params: { badge },
    props: { badge }
  }));
}

const { badge } = Astro.props as { badge: CardType };
const meta = TYPE_META[badge];
const cards = await getCollection("cards");
const matching = cards
  .filter((card) => card.data.type === badge)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<SiteLayout title={`${meta.title} cards`} description={meta.description}>
  <section class="hero">
    <p class="eyebrow"><a href={withBase("/badges/")}>Badge index</a></p>
    <div class="badge-row">
      <Badge label={badge} />
    </div>
    <h1>{meta.title} cards</h1>
    <p class="lede">{meta.description}</p>
    <p class="side-panel-meta">{matching.length} card{matching.length === 1 ? "" : "s"}</p>
  </section>

  <section>
    {matching.length === 0 ? (
      <p class="side-panel-meta">No cards with this type yet.</p>
    ) : (
      <div class="grid">
        {matching.map((card) => (
          <article class="card">
            <div class="badge-row">
              <Badge label={card.data.type} href={badgeTypeHref(base, card.data.type)} />
              <Badge label={card.data.status} variant={card.data.status} href={withBase(`/badges/status/${card.data.status}/`)} />
            </div>
            <h2>
              <ConceptCardLink
                href={cardHref(base, card.id)}
                slug={card.id}
                logoSize={card.data.type === "concept" ? 40 : undefined}
              >
                {card.data.title}
              </ConceptCardLink>
            </h2>
            <p>{card.data.summary}</p>
          </article>
        ))}
      </div>
    )}
  </section>

  <section>
    <p><a href={withBase("/badges/")}>All badges</a> · <a href={withBase("/cards/")}>All cards</a></p>
  </section>
</SiteLayout>
