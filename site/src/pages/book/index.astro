---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Badge from "../../components/Badge.astro";
import book from "../../data/book.json";
import { getCollection } from "astro:content";
import { cardHref } from "../../lib/site-urls";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const cards = await getCollection("cards");
const chapterCardFor = (chapterId: string) =>
  cards.find((card) => card.data.bookPageId === chapterId && ["chapter", "appendix", "frontmatter"].includes(card.data.type));
const toCardHref = (id: string) => cardHref(base, id);
---

<SiteLayout title="Book Map" description="Compact map of the canonical PDF manuscript.">
  <section class="hero">
    <p class="eyebrow">Canonical long-form</p>
    <h1>{book.title}</h1>
    <p class="lede">
      {book.subtitle}. Read chapters on the site or download the PDF for the full manuscript including appendices not yet on the web.
    </p>
    <div class="button-row">
      <a class="button primary" href={toCardHref(chapterCardFor("frontmatter")!.id)}>Start with front matter</a>
      <a class="button" href="https://github.com/GunnarZarncke/towards-asi-alignment">View source repository</a>
    </div>
  </section>

  <section class="readable">
    <h2>Also on the site</h2>
    <ul>
      <li><a href={toCardHref(chapterCardFor("frontmatter")!.id)}>Front matter</a></li>
      <li><a href={toCardHref(chapterCardFor("appB")!.id)}>Bridge crosswalk (Appendix B)</a></li>
      <li><a href={toCardHref(chapterCardFor("appC")!.id)}>Institutional translation (Appendix C)</a></li>
      <li><a href={toCardHref(chapterCardFor("appM")!.id)}>Institutional histories (Appendix M)</a></li>
      <li><a href={toCardHref(chapterCardFor("appD")!.id)}>Worked example (Appendix D)</a></li>
      <li><a href={toCardHref(chapterCardFor("appF")!.id)}>Research program (Appendix F)</a></li>
      <li><a href={withBase("/references/")}>References</a></li>
    </ul>
  </section>

  {book.parts.map((part) => (
    <section>
      <h2>{part.title}</h2>
      <p>{part.summary}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Chapter</th>
              <th>Title</th>
              <th>Status</th>
              <th>Formal density</th>
            </tr>
          </thead>
          <tbody>
            {part.chapters.map((chapter) => {
              const chapterCard = chapterCardFor(chapter.id);
              return (
              <tr>
                <td>{chapter.id}</td>
                <td>
                  {chapterCard ? (
                    <a href={toCardHref(chapterCard.id)}>{chapter.title}</a>
                  ) : (
                    <span>{chapter.title}</span>
                  )}
                </td>
                <td><Badge label={chapter.status} variant={chapter.status} /></td>
                <td>{chapter.formalDensity}</td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</SiteLayout>
