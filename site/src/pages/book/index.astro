---
import SiteLayout from "../../layouts/SiteLayout.astro";
import book from "../../data/book.json";
import { getCollection } from "astro:content";
import { cardHref, pdfHref } from "../../lib/site-urls";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const cards = await getCollection("cards");
const chapterCardFor = (chapterId: string) =>
  cards.find((card) => card.data.bookPageId === chapterId && ["chapter", "appendix", "frontmatter"].includes(card.data.type));
const toCardHref = (id: string) => cardHref(base, id);
---

<SiteLayout title="Book" description="Download the manuscript PDF and browse parts.">
  <section class="hero book-landing-hero">
    <p class="eyebrow">Book</p>
    <h1>{book.title}</h1>
    <p class="lede">{book.subtitle}</p>
    <div class="button-row">
      <a class="button primary" href={pdfHref(base)}>Download PDF</a>
      <a class="button" href={toCardHref(chapterCardFor("frontmatter")!.id)}>Front matter</a>
      <a class="button" href={withBase("/references/")}>References</a>
      <a class="button" href={withBase("/book/map/")}>All chapters</a>
    </div>
  </section>

  <ol class="book-parts">
    {book.parts.map((part) => (
      <li>
        <h2><a href={withBase(`/book/map/#${part.id}`)}>{part.title}</a></h2>
        {part.summary && <p>{part.summary}</p>}
      </li>
    ))}
  </ol>
</SiteLayout>

<style>
  .book-landing-hero {
    padding-top: 0;
    padding-bottom: 1.25rem;
  }

  .book-parts {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--max-readable);
  }

  .book-parts li + li {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border, #c8d4e0);
  }

  .book-parts h2 {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
  }

  .book-parts p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
