---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Badge from "../../components/Badge.astro";
import Formula from "../../components/Formula.astro";
import LinkIndicator from "../../components/LinkIndicator.astro";
import ConceptLogo from "../../components/ConceptLogo.astro";
import ConceptCardLink from "../../components/ConceptCardLink.astro";
import BridgeCrosswalkTable from "../../components/BridgeCrosswalkTable.astro";
import CardSection from "../../components/CardSection.astro";
import TermLinksReverse from "../../components/TermLinksReverse.astro";
import LeanDeclLinks from "../../components/LeanDeclLinks.astro";
import ReferenceIndex from "../../components/ReferenceIndex.astro";
import LeanCodeBlock from "../../components/LeanCodeBlock.astro";
import LeanTryIt from "../../components/LeanTryIt.astro";
import FieldLifecycleAxis from "../../components/FieldLifecycleAxis.astro";
import FieldSpecifyConstructTable from "../../components/FieldSpecifyConstructTable.astro";
import FieldAdjacentWork from "../../components/FieldAdjacentWork.astro";
import FieldBridgeGraphSection from "../../components/FieldBridgeGraphSection.astro";
import partGems from "../../data/part-gems.json";
import { GEM_LABEL, badgeGemHref, isGemSlug } from "../../lib/gems";
import references from "../../data/references.json";
import demosIndex from "../../data/demos.json";
import bookIndex from "../../data/book.json";
import crosswalkRows from "../../data/bridge-crosswalk.json";
import fieldNewsIndex from "../../data/field-news.json";
import fieldAgendasData from "../../data/field-agendas.json";
import leanSpine from "../../data/lean-spine.json";
import { bookFullHref, bookHref, cardHref as buildCardHref, pdfHref, resolveCard, routeSlug } from "../../lib/site-urls";
import { badgeStatusHref, badgeTypeHref } from "../../lib/badges";
import { hasConceptLogo } from "../../lib/concept-logos";
import { referenceLinksFor } from "../../lib/reference-links";

export async function getStaticPaths() {
  const cards = await getCollection("cards");
  return [
    ...cards.map((card) => ({
      params: { slug: card.id },
      props: { card, showFullText: false as const }
    })),
    ...cards
      .filter((card) => card.data.overviewOnly && card.data.bookPageId)
      .map((card) => ({
        params: { slug: `${card.id}/full` },
        props: { card, showFullText: true as const }
      }))
  ];
}

const { card, showFullText = false } = Astro.props;

if (card.data.type === "essay") {
  return Astro.redirect(`${import.meta.env.BASE_URL}essay/${card.id}/`, 301);
}

if (card.id === "releases-updates") {
  return Astro.redirect(`${import.meta.env.BASE_URL}updates/`, 301);
}

const allCards = await getCollection("cards");
const allBookPages = await getCollection("book");
const isBookUnit = ["chapter", "appendix", "frontmatter"].includes(card.data.type);
const isOverviewHub = card.data.overviewOnly === true && !showFullText;
const bookEntry = isBookUnit && card.data.bookPageId && !isOverviewHub
  ? allBookPages.find((entry) => routeSlug(entry.id) === routeSlug(card.data.bookPageId!))
  : undefined;
const { Content } = bookEntry ? await render(bookEntry) : await render(card);
const isGem = (slug: string) => isGemSlug(slug);
const refByKey = new Map(references.map((entry) => [entry.key, entry]));

const isCrosswalkCard = card.id === "chapters/appb";
const isReferenceIndexCard = card.id === "reference-index";
const isReferenceCard = card.data.type === "reference";
const isExperimentCard = card.data.type === "experiment";
const isReleaseCard = card.data.type === "release";
const isNewsCard = card.data.type === "news";
const isAgendaCard = card.data.type === "agenda";
const isBridgeCard = card.data.type === "bridge";
const isProjectionCard = card.id.startsWith("subsumption-");
const demoFor = (demoId: string) => demosIndex.demos.find((demo) => demo.id === demoId);
const partGemSlugs = isBookUnit && card.data.part ? partGems[card.data.part as keyof typeof partGems] || [] : [];
const relatedSlugs = [...new Set([...partGemSlugs, ...card.data.related])];
const related = relatedSlugs
  .map((slug: string) => resolveCard(allCards, slug))
  .filter(Boolean);

const chapterCardFor = (chapterId: string) =>
  allCards.find(
    (candidate) =>
      routeSlug(candidate.data.bookPageId ?? "") === routeSlug(chapterId) &&
      ["chapter", "appendix", "frontmatter"].includes(candidate.data.type)
  );

const chapterIdForNews =
  isBookUnit && card.data.bookPageId
    ? routeSlug(card.data.bookPageId)
    : isBookUnit
      ? routeSlug(card.id.replace(/^chapters\//, ""))
      : null;
const relatedNews =
  chapterIdForNews != null
    ? [...fieldNewsIndex]
        .filter((item) => item.chapters.includes(chapterIdForNews))
        .sort((a, b) => b.date.localeCompare(a.date))
    : [];

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const projectionGraphUrl = card.data.graphNodeId
  ? withBase("/lean/graph/field-subsumptions/")
  : null;
const bridgeGraphUrl = withBase("/cards/bridge-assumptions/#bridge-dependencies");
/** Cards whose main view is an Astro field embed; page template owns the sole h1 (frontmatter title). */
const fieldEmbedCardIds = new Set([
  "alignment-lifecycle",
  "bridge-assumptions",
  "alignment-target",
  "bearer-admission-adjacent"
]);
const hasFieldEmbed = fieldEmbedCardIds.has(card.id);
const cardUrlForTermLinks = `/cards/${card.id}/`;
const gemHref = badgeGemHref(base);
const cardHref = (id: string) => buildCardHref(base, id);
const refCardHref = (key: string) => buildCardHref(base, `references/${key.toLowerCase()}`);
const toBookHref = (chapterId: string) => bookHref(base, chapterId);
const titleForChapter = (chapterId: string) =>
  bookIndex.chapters.find((ch: { id: string; title: string }) => ch.id === chapterId)?.title ??
  allCards.find((c) => c.data.bookPageId === chapterId)?.data.title ??
  null;

const chapterOrder = (id: string) => {
  const n = id.match(/^ch(\d+)$/)?.[1];
  return n ? Number(n) : id === "appb" ? 1000 : 9999;
};

const crosswalkBridgeSlugs = [...new Set(crosswalkRows.flatMap((row) => row.cards.filter((slug) => slug.startsWith("mb"))))].sort();
const crosswalkConceptSlugs = [
  ...new Set([
    ...crosswalkRows.flatMap((row) => row.cards.filter((slug) => !slug.startsWith("mb"))),
    "bridge-assumptions",
    "evidence-and-uncertainty",
    "what-not-claiming"
  ])
].sort();
const crosswalkChapterIds = [...new Set(crosswalkRows.flatMap((row) => row.chapters))].sort(
  (a, b) => chapterOrder(a) - chapterOrder(b)
);

const repoBase = "https://github.com/GunnarZarncke/towards-asi-alignment/blob/main";

function legacySpineNodeId(nodeId: string) {
  return (
    nodeId.match(/^(P\d+[A-Za-z]?)/)?.[1] ||
    nodeId.match(/^(MB\d+[a-z]?)/i)?.[1]?.toUpperCase() ||
    null
  );
}

function playgroundForLeanNode(nodeId: string) {
  const spineId = legacySpineNodeId(nodeId);
  if (!spineId) return null;
  return leanSpine.playgrounds.find((pg) => pg.nodeId === spineId) ?? null;
}

const leanPlaygrounds = [
  ...new Map(
    card.data.leanNodes
      .map((node) => playgroundForLeanNode(node.nodeId))
      .filter(Boolean)
      .map((pg) => [pg!.id, pg!])
  ).values()
];

const claimLink = card.data.claimId
  ? { label: `Claims ledger: ${card.data.claimId}`, url: `${repoBase}/metadata/claims-ledger.md#claim-id-${card.data.claimId.toLowerCase()}` }
  : null;
const externalLinks = claimLink ? [claimLink, ...card.data.external] : card.data.external;

const bibEntry = isReferenceCard && card.data.bibKey ? refByKey.get(card.data.bibKey) : undefined;
const referenceLinks = isReferenceCard
  ? referenceLinksFor(card.data.external, bibEntry)
  : [];
const pageDescription = showFullText
  ? `${card.data.summary} Full synced manuscript text on the companion site.`
  : card.data.summary;
---

<SiteLayout title={card.data.title} description={pageDescription} ogType="article">
  <article class:list={["two-column", bookEntry && "book-page"]}>
    <div class:list={["content-card", bookEntry && "readable"]}>
      <div class="badge-row">
        <Badge label={card.data.type} href={badgeTypeHref(base, card.data.type)} />
        <Badge label={card.data.status} variant={card.data.status} href={badgeStatusHref(base, card.data.status)} />
        {isGem(card.id) && <Badge label={GEM_LABEL} variant={GEM_LABEL} href={gemHref} />}
        {card.data.part && <Badge label={card.data.part} variant="framework" />}
        {card.data.formalDensity && <Badge label={card.data.formalDensity} />}
        {isReleaseCard && card.data.version && <Badge label={`v${card.data.version}`} variant="framework" />}
        {isReleaseCard && card.data.releasedAt && <Badge label={card.data.releasedAt} />}
      </div>
      {!bookEntry ? (
        <>
          {card.data.type === "concept" && hasConceptLogo(card.id) ? (
            <h1>
              {card.data.title}
              <ConceptLogo slug={card.id} size={72} decorative={false} label={card.data.title} />
            </h1>
          ) : (
            <h1>{card.data.title}</h1>
          )}
          {!isOverviewHub && <p class="lede">{card.data.summary}</p>}
          {isOverviewHub && card.data.bookPageId && (
            <p class="button-row">
              <a class="button primary" href={bookFullHref(base, card.data.bookPageId)}>Read full appendix on site</a>
            </p>
          )}
          {isExperimentCard && card.data.experimentLineId && (
            <p class="side-panel-meta">
              <a href={withBase("/experiments/")}>All experiment lines</a>
              {" · "}
              <a href={withBase(`/experiments/findings/${card.data.experimentLineId}/`)}>Key findings</a>
            </p>
          )}
          {isReleaseCard && (
            <p class="side-panel-meta">
              <a href={withBase("/updates/")}>All releases (newest first)</a>
            </p>
          )}
          {isNewsCard && (
            <p class="side-panel-meta">
              <a href={withBase("/news/")}>All related news</a>
            </p>
          )}
        </>
      ) : (
        <>
          {showFullText && card.data.bookPageId && (
            <p class="button-row">
              <a class="button" href={cardHref(card.id)}>Case study overview</a>
            </p>
          )}
          <p class="side-panel-meta">
            Source:{" "}
            <a href={`${repoBase}/${bookEntry.data.sourceFile}`} target="_blank" rel="noopener noreferrer">
              <code>{bookEntry.data.sourceFile}</code><LinkIndicator kind="github" />
            </a>
          </p>
        </>
      )}

      {isReferenceCard && referenceLinks.length > 0 && (
        <section class="reference-source">
          <h2>Publication links</h2>
          <ul class="reference-link-list">
            {referenceLinks.map((link) => (
              <li>
                <strong>{link.label}:</strong>{" "}
                <a href={link.url} target="_blank" rel="noopener noreferrer">{link.url}<LinkIndicator kind="external" /></a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {card.data.decision && (
        <section class="callout">
          <h2>What decision changes?</h2>
          <p>{card.data.decision}</p>
        </section>
      )}

      <div class:list={[{ "card-body": hasFieldEmbed }]}>
        <Content />
      </div>

      {card.id === "alignment-lifecycle" && <FieldLifecycleAxis base={base} />}
      {card.id === "bridge-assumptions" && <FieldBridgeGraphSection base={base} />}
      {card.id === "alignment-target" && <FieldSpecifyConstructTable base={base} />}
      {card.id === "bearer-admission-adjacent" && <FieldAdjacentWork base={base} />}

      {isCrosswalkCard && (
        <BridgeCrosswalkTable
          cardHref={cardHref}
          chapterHref={toBookHref}
        />
      )}

      {isOverviewHub && related.length > 0 && (
        <>
          <CardSection
            title="Historical case studies"
            sectionId="appm-case-studies"
            cards={related.map((entry) => ({
              id: entry!.id,
              title: entry!.data.title,
              summary: entry!.data.summary,
              type: entry!.data.type,
              status: entry!.data.status
            }))}
            initialCount={related.length}
            cardHref={cardHref}
          />
          <p class="button-row">
            {card.data.bookPageId && (
              <a class="button primary" href={bookFullHref(base, card.data.bookPageId)}>Read full appendix on site</a>
            )}
            <a class="button" href={pdfHref(base)}>Read full appendix in PDF</a>
          </p>
        </>
      )}

      {isReferenceIndexCard && (
        <ReferenceIndex cardHref={cardHref} />
      )}

      {isReferenceIndexCard && (
        <p class="button-row">
          <a class="button" href={withBase("/references/")}>Chapter-grouped bibliography</a>
        </p>
      )}

      {leanPlaygrounds.map((pg) => (
        <>
          <LeanCodeBlock
            code={pg.code}
            sourceFile={pg.file}
            sourceUrl={`${repoBase}/${pg.file}`}
          />
          <LeanTryIt liveUrl={pg.liveUrl} title={`Try ${pg.nodeId} in Lean 4 Web`} />
          <p class="side-panel-meta">
            <a href={withBase(`/lean/node/${pg.nodeId}/`)}>Lean spine node {pg.nodeId}</a>
          </p>
        </>
      ))}

      {card.data.formulas.length > 0 && (
        <section class="formulas">
          <h2>Formulas</h2>
          {card.data.formulas.map((formula) => (
            <Formula latex={formula.latex} explanation={formula.explanation} chapterId={formula.chapterId} />
          ))}
        </section>
      )}
      {isProjectionCard && card.data.leanNodes.length > 0 && (
        <section class="lean-source-main">
          <h2>Lean source</h2>
          <p class="side-panel-meta">
            Machine-checked declarations on the shared finite domain — each links to the theorem in the repo.
          </p>
          <LeanDeclLinks nodes={card.data.leanNodes} graphNodeId={card.data.graphNodeId} />
        </section>
      )}

      {card.data.evidence && (
        <section class="callout">
          <h2>What would count as evidence?</h2>
          <p>{card.data.evidence}</p>
        </section>
      )}

      {isReferenceCard && card.data.bibKey && (
        <p class="button-row">
          <a class="button" href={withBase("/references/")}>Chapter-grouped bibliography</a>
          {" "}
          <a class="button" href={cardHref("reference-index")}>All reference cards</a>
        </p>
      )}

      {bookEntry && (
        <p class="button-row">
          <a class="button" href={pdfHref(base)}>Read in PDF</a>
        </p>
      )}

    </div>

    <aside class="side-panel" aria-label="Related content" id="related">
      <h2>Related content</h2>
      {isOverviewHub && card.data.bookPageId && (
        <>
          <h3>Full appendix</h3>
          <ul>
            <li><a href={bookFullHref(base, card.data.bookPageId)}>Read on site</a></li>
          </ul>
        </>
      )}
      {isAgendaCard && (
        <>
          <h3>Field hub</h3>
          <ul>
            <li><a href={withBase("/field/coverage/")}>Coverage matrix &amp; evidence catalog</a></li>
            <li><a href={withBase("/field/coverage/#coverage-matrix")}>Matrix row for this agenda</a></li>
          </ul>
          {card.data.bookBridges.length > 0 && (
            <>
              <h3>Related field cruxes</h3>
              <ul>
                {card.data.bookBridges.map((mb) => {
                  const bridge = (fieldAgendasData.bridges as Array<{ key: string; noun: string; cardSlug: string }> | undefined)?.find(
                    (row) => row.key === mb
                  );
                  const slug =
                    bridge?.cardSlug ??
                    fieldAgendasData.mbBridgeCards[mb as keyof typeof fieldAgendasData.mbBridgeCards];
                  const label = bridge?.noun ?? mb;
                  return (
                    <li>
                      {slug ? <a href={cardHref(slug)}>{label}</a> : label}
                    </li>
                  );
                })}
              </ul>
            </>
          )}
        </>
      )}
      {!isBookUnit && !isReferenceCard && !isAgendaCard && card.data.bookChapters.length > 0 && (
        <>
          <h3>Book chapters</h3>
          <ul>
            {card.data.bookChapters.map((chapterId) => {
              const chapterCard = chapterCardFor(chapterId);
              return (
                <li>
                  {chapterCard ? (
                    <a href={cardHref(chapterCard.id)}>{chapterCard.data.title}</a>
                  ) : (
                    <a href={toBookHref(chapterId)}>{chapterId}</a>
                  )}
                </li>
              );
            })}
          </ul>
        </>
      )}
      {!isBookUnit && card.data.bookSections.length > 0 && (
        <>
          <h3>Book sections</h3>
          <ul>
            {card.data.bookSections.map((section) => {
              const chapterCard = chapterCardFor(section.chapterId);
              return (
                <li>
                  {chapterCard ? (
                    <a href={cardHref(chapterCard.id)}>{section.label}</a>
                  ) : (
                    <a href={toBookHref(section.chapterId)}>{section.chapterId}: {section.label}</a>
                  )}
                </li>
              );
            })}
          </ul>
        </>
      )}
      {card.data.leanNodes.length > 0 && (
        <>
          <h3>Lean dependency spine</h3>
          <LeanDeclLinks nodes={card.data.leanNodes} graphNodeId={card.data.graphNodeId} />
        </>
      )}
      {isProjectionCard && projectionGraphUrl && (
        <>
          <h3>Field graph</h3>
          <p><a href={projectionGraphUrl}>Open in field projections graph</a></p>
        </>
      )}
      {(isBridgeCard || card.id === "bridge-assumptions") && card.id !== "bridge-assumptions" && (
        <>
          <h3>Related resource</h3>
          <p><a href={bridgeGraphUrl}>Bridge dependency map</a></p>
        </>
      )}
      {(isBridgeCard || card.id === "bridge-assumptions") && card.id === "bridge-assumptions" && (
        <>
          <h3>Related resource</h3>
          <p><a href={withBase("/cards/alignment-lifecycle/")}>Alignment lifecycle</a></p>
        </>
      )}
      {isProjectionCard && (
        <TermLinksReverse url={cardUrlForTermLinks} />
      )}
      {card.data.evidenceNotes.length > 0 && (
        <>
          <h3>Experiment evidence</h3>
          <ul>
            {card.data.evidenceNotes.map((note) => (
              <li>
                <strong>{note.finding}</strong> &mdash; {note.summary}
                <br /><span class="side-panel-meta">{note.source}{note.scenario ? ` / ${note.scenario}` : ""} &middot; <a href={note.resultsPath} target="_blank" rel="noopener noreferrer">results<LinkIndicator kind="github" /></a></span>
              </li>
            ))}
          </ul>
        </>
      )}
      {card.data.demos.length > 0 && (
        <>
          <h3>Interactive demos</h3>
          <ul>
            {card.data.demos.map((demo) => {
              const entry = demoFor(demo.demoId);
              const href = entry ? withBase(entry.sitePath) : `https://github.com/GunnarZarncke/towards-asi-alignment/tree/main/demos/${demo.demoId}`;
              return (
              <li>
                {entry ? (
                  <>
                    <a href={href} target="_blank" rel="noopener noreferrer">{entry.title}<LinkIndicator kind="newtab" /></a>
                    {" · "}
                    <a href={entry.standaloneUrl} title="Standalone demo server" target="_blank" rel="noopener noreferrer">Standalone<LinkIndicator kind="newtab" /></a>
                    {entry.liveUrl && (
                      <>
                        {" · "}
                        <a href={entry.liveUrl} target="_blank" rel="noopener noreferrer">Live deployment<LinkIndicator kind="external" /></a>
                      </>
                    )}
                    {" · "}
                    <a href={withBase(`/demos/all/#${demo.demoId}`)}>Inventory</a>
                  </>
                ) : (
                  <a href={href} target="_blank" rel="noopener noreferrer">{demo.demoId}<LinkIndicator kind="github" /></a>
                )}
                <br /><span class="side-panel-meta">{demo.summary || entry?.summary}</span>
              </li>
              );
            })}
          </ul>
          <p class="side-panel-meta"><a href={withBase("/demos/")}>Chapter demos</a></p>
        </>
      )}
      {isCrosswalkCard && (
        <>
          <h3>Bridge cards</h3>
          <ul>
            {crosswalkBridgeSlugs.map((slug) => {
              const entry = allCards.find((c) => c.id === slug);
              return (
                <li>
                  <ConceptCardLink href={cardHref(slug)} slug={slug}>
                    {entry?.data.title ?? slug}
                  </ConceptCardLink>
                </li>
              );
            })}
          </ul>
          <h3>Concept cards</h3>
          <ul>
            {crosswalkConceptSlugs.map((slug) => {
              const entry = allCards.find((c) => c.id === slug);
              return (
                <li>
                  <ConceptCardLink href={cardHref(slug)} slug={slug}>
                    {entry?.data.title ?? slug}
                  </ConceptCardLink>
                  {isGem(slug) && <Badge label={GEM_LABEL} variant={GEM_LABEL} href={gemHref} />}
                </li>
              );
            })}
          </ul>
          <h3>Book chapters</h3>
          <ul>
            {crosswalkChapterIds.map((chapterId) => {
              const chapterCard = chapterCardFor(chapterId);
              return (
                <li>
                  {chapterCard ? (
                    <a href={cardHref(chapterCard.id)}>{chapterCard.data.title}</a>
                  ) : (
                    <a href={toBookHref(chapterId)}>{titleForChapter(chapterId) ?? chapterId}</a>
                  )}
                </li>
              );
            })}
          </ul>
        </>
      )}
      {!isCrosswalkCard && related.length > 0 && (
        <>
          <h3>{isBookUnit ? "Concept cards in this chapter" : "Related cards"}</h3>
          <ul>
            {related.map((relatedCard) => (
              <li>
                <ConceptCardLink href={cardHref(relatedCard!.id)} slug={relatedCard!.id}>
                  {relatedCard!.data.title}
                </ConceptCardLink>
                {isGem(relatedCard!.id) && <Badge label={GEM_LABEL} variant={GEM_LABEL} href={gemHref} />}
              </li>
            ))}
          </ul>
        </>
      )}
      {isBookUnit && relatedNews.length > 0 && (
        <>
          <h3>Related news</h3>
          <ul>
            {relatedNews.map((item) => (
              <li>
                <a href={cardHref(item.card)}>{item.title}</a>
                <span class="side-panel-meta"> ({item.date})</span>
              </li>
            ))}
          </ul>
          <p class="side-panel-meta">
            <a href={withBase("/news/")}>Full news index</a>
          </p>
        </>
      )}
      {isReferenceCard && card.data.citedIn.length > 0 && (
        <>
          <h3>Cited in</h3>
          <ul>
            {card.data.citedIn.map((unitId) => {
              const unitCard = chapterCardFor(unitId);
              return (
                <li>
                  {unitCard ? (
                    <a href={cardHref(unitCard.id)}>{unitCard.data.title}</a>
                  ) : (
                    <a href={toBookHref(unitId)}>{titleForChapter(unitId) ?? unitId}</a>
                  )}
                  <span class="side-panel-meta"> ({unitId})</span>
                </li>
              );
            })}
          </ul>
        </>
      )}
      {card.data.citeKeys.length > 0 && (
        <>
          <h3>Published work</h3>
          <ul>
            {card.data.citeKeys.map((key) => {
              const entry = refByKey.get(key);
              return (
                <li>
                  <a href={refCardHref(key)}>
                    {entry ? `${entry.shortLabel} — ${entry.title}` : key}
                  </a>
                </li>
              );
            })}
          </ul>
        </>
      )}
      {externalLinks.length > 0 && !isReferenceCard && (
        <>
          <h3>External links</h3>
          <ul>
            {externalLinks.map((link) => (
              <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<LinkIndicator kind={link.url.includes("github.com") ? "github" : "external"} /></a></li>
            ))}
          </ul>
        </>
      )}
    </aside>
  </article>
</SiteLayout>

