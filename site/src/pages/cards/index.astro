---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import CardTopicList from "../../components/CardTopicList.astro";
import { cardHref as buildCardHref } from "../../lib/site-urls";
import { cardCatalogSections, highlightEntries } from "../../lib/card-catalog";
import fieldProjectionGems from "../../data/field-projection-gems.json";
import experimentsData from "../../data/experiments.json";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const cardHref = (id: string) => buildCardHref(base, id);

const cards = await getCollection("cards");
const highlights = highlightEntries(cards);
const sections = cardCatalogSections(cards, fieldProjectionGems, experimentsData);
---

<SiteLayout title="Cards" description="Short concept, chapter, bridge, and glossary cards grouped by topic.">
  <section class="hero">
    <p class="eyebrow">Cards</p>
    <h1>Cards</h1>
    <p class="button-row">
      <a class="button" href={withBase("/glossary/")}>Glossary</a>
      <a class="button" href={withBase("/badges/")}>Badge index</a>
      <a class="button" href={withBase("/badges/gem/")}>Highlights</a>
      <a class="button" href={withBase("/essay/")}>Essays</a>
    </p>
  </section>

  <CardTopicList
    title="Highlights"
    sectionId="highlights"
    cards={highlights}
    cardHref={cardHref}
    moreHref={withBase("/badges/gem/")}
    showSummaries={true}
    previewCount={3}
    foldRest={true}
  />

  {sections.map((section) => (
    <CardTopicList
      title={section.title}
      sectionId={section.id}
      cards={section.cards}
      cardHref={cardHref}
      moreHref={withBase(`/cards/browse/#${section.id}`)}
      previewCount={8}
    />
  ))}

  <p class="side-panel-meta"><a href={withBase("/cards/browse/")}>All cards</a></p>
</SiteLayout>
