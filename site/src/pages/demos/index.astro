---
import SiteLayout from "../../layouts/SiteLayout.astro";
import LinkIndicator from "../../components/LinkIndicator.astro";
import demos from "../../data/demos.json";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const featured = demos.demos.find((demo) => demo.id === "ch16-value-bundle-simulator") ?? demos.demos[0];
---

<SiteLayout title="Demos" description="Interactive chapter toys for exploring manuscript ideas.">
  <section class="hero">
    <p class="eyebrow">Demos</p>
    <h1>Demos</h1>
    <div class="button-row">
      <a class="button primary" href={withBase(featured.sitePath)} target="_blank" rel="noopener noreferrer">
        Launch {featured.title}<LinkIndicator kind="newtab" />
      </a>
      <a class="button" href={withBase("/demos/all/")}>All demos</a>
    </div>
    <p class="side-panel-meta">Not a test of frontier systems.</p>
  </section>
</SiteLayout>
