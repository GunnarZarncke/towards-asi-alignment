---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import LinkIndicator from "../../../components/LinkIndicator.astro";
import experiments from "../../../data/experiments.json";
import { cardHref } from "../../../lib/site-urls";
import {
  experimentFindingsBodyMarkdown,
  renderMarkdown,
  renderMarkdownList
} from "../../../lib/render-markdown";

export async function getStaticPaths() {
  const fromLines = experiments.lines
    .filter((line) => (line.headlineFindings?.length ?? 0) > 0 || line.findingsPath || line.findingsUrl)
    .map((line) => ({
      params: { id: line.id },
      props: { line }
    }));
  const fromLedgers = (experiments.ledgers ?? [])
    .filter((ledger) => !experiments.lines.some((line) => line.id === ledger.lineId))
    .filter((ledger) => (ledger.headlineFindings?.length ?? 0) > 0 || ledger.path)
    .map((ledger) => ({
      params: { id: ledger.lineId },
      props: {
        line: {
          id: ledger.lineId,
          title: ledger.label,
          headlineFindings: ledger.headlineFindings ?? [],
          findingsUrlResolved: ledger.repoUrl,
          sourceUrl: "https://github.com/GunnarZarncke/towards-asi-alignment/tree/main/experiments/witness",
          findingsSitePath: ledger.findingsSitePath,
          cardId: ledger.overviewCardId ?? ledger.lineId
        }
      }
    }));
  return [...fromLines, ...fromLedgers];
}

const { line } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const findings = line.headlineFindings ?? [];
const figures = line.findingsFigures ?? [];
const fullLedgerUrl = line.findingsUrlResolved;
const experimentCardUrl = cardHref(base, `experiments/${line.cardId ?? line.id}`, "experiment");

const findingsBodyMarkdown = experimentFindingsBodyMarkdown(line);
const findingsBodyHtml = findingsBodyMarkdown ? await renderMarkdown(findingsBodyMarkdown) : "";
const findingHtml = findings.length > 0 ? await renderMarkdownList(findings) : [];
---

<SiteLayout
  title={`${line.title} — key findings`}
  description={`Curated key findings from ${line.title}. Full ledger on GitHub.`}
>
  <article class="readable">
    <p class="eyebrow">
      <a href={withBase("/experiments/")}>Experiments</a>
      {" · "}
      <a href={cardHref(base, "negative-results", "concept")}>Negative results</a>
    </p>
    <h1>{line.title}</h1>
    <p class="lede">
      Setup and what was tested: <a href={experimentCardUrl}>experiment card</a>.
    </p>

    <p class="button-row">
      <a class="button primary" href={experimentCardUrl}>Experiment card</a>
      {line.sourceUrl && (
        <a class="button" href={line.sourceUrl} target="_blank" rel="noopener noreferrer">
          Source on GitHub<LinkIndicator kind="github" />
        </a>
      )}
      {fullLedgerUrl && (
        <a class="button" href={fullLedgerUrl} target="_blank" rel="noopener noreferrer">
          Results ledger<LinkIndicator kind="github" />
        </a>
      )}
      <a class="button" href={withBase("/experiments/")}>All experiment lines</a>
    </p>

    {findingsBodyHtml ? <div class="readable" set:html={findingsBodyHtml} /> : null}

    {findings.length > 0 ? (
      <>
        <h2>Key findings</h2>
        <p class="side-panel-meta">
          Curated summaries extracted from the line's findings ledger. Bug fixes, superseded runs, and process detail are in the full ledger on GitHub.
        </p>
        <ul>
          {findingHtml.map((html) => (
            <li set:html={html} />
          ))}
        </ul>
      </>
    ) : (
      <section class="callout warning">
        <p>
          No curated key findings are tagged for this line yet. See the{" "}
          {fullLedgerUrl ? (
            <a href={fullLedgerUrl} target="_blank" rel="noopener noreferrer">full ledger<LinkIndicator kind="github" /></a>
          ) : (
            "full ledger"
          )}
          {" "}or the <a href={experimentCardUrl}>experiment card</a>.
        </p>
      </section>
    )}

    {figures.length > 0 && (
      <>
        <h2>Figures</h2>
        <p class="side-panel-meta">
          Selected plots from the findings ledger; full tables and additional panels are on GitHub.
        </p>
        {figures.map((figure) => (
          <figure class="book-figure">
            <img src={withBase(figure.path)} alt={figure.alt} loading="lazy" />
            {figure.caption && <figcaption>{figure.caption}</figcaption>}
          </figure>
        ))}
      </>
    )}
  </article>
</SiteLayout>
