---
import SiteLayout from "../../layouts/SiteLayout.astro";
import experiments from "../../data/experiments.json";
import { cardHref } from "../../lib/site-urls";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const oneLine = (text: string) =>
  text
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/\s+/g, " ")
    .trim();

const KIND_ORDER = ["sim", "external", "witness"] as const;

const sections = KIND_ORDER.map((kind) => {
  const meta = experiments.kinds?.[kind] ?? {
    title: kind,
    blurb: "",
    cardId: kind
  };
  return { kind, ...meta };
});

const purpose = oneLine(experiments.purpose ?? "");
---

<SiteLayout
  title="Experiments"
  description={purpose || "Simulations, external tests, and Witness — methodology checks with recorded failures."}
>
  <section class="hero">
    <p class="eyebrow">Experiments</p>
    <h1>Experiments</h1>
    <p class="lede">{purpose}</p>
    <div class="button-row">
      <a class="button" href={cardHref(base, "negative-results", "concept")}>Negative results</a>
      <a class="button" href={withBase("/experiments/coverage/")}>Coverage</a>
      <a class="button" href={cardHref(base, "experiment-methodology", "concept")}>Methodology</a>
    </div>
  </section>

  <section class="experiment-hub-nav readable" aria-label="Experiment classes">
    <div class="experiment-hub-grid">
      {
        sections.map((section) => (
          <article class="experiment-hub-card" id={section.kind === "sim" ? "sims" : section.kind}>
            <h2>
              <a href={cardHref(base, `experiments/${section.cardId}`)}>{section.title}</a>
            </h2>
            <p>{oneLine(section.blurb)}</p>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .experiment-hub-nav {
    margin: 0 0 2.5rem;
    max-width: 52rem;
  }

  .experiment-hub-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .experiment-hub-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .experiment-hub-card {
    margin: 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border, #c8d4e0);
    border-radius: var(--radius-card, 8px);
    background: var(--color-surface, #fafbfc);
  }

  .experiment-hub-card h2 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .experiment-hub-card p {
    margin: 0;
    line-height: 1.5;
    color: var(--color-muted, #4a5568);
    font-size: 0.95em;
  }

  #sims,
  #external,
  #witness {
    scroll-margin-top: 4.5rem;
  }
</style>
