---
import SiteLayout from "../../layouts/SiteLayout.astro";
import experiments from "../../data/experiments.json";
import { cardHref } from "../../lib/site-urls";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const oneLine = (text: string) =>
  text
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/\s+/g, " ")
    .trim();

const inRepoLines = [...experiments.lines]
  .filter((line) => line.location.startsWith("experiments/"))
  .sort((a, b) => a.order - b.order);
---

<SiteLayout
  title="Experiments"
  description="Empirical sanity-check lines for this project's bridge cruxes, including recorded failures."
>
  <section class="hero">
    <p class="eyebrow">Experiments</p>
    <h1>Experiments</h1>
    <div class="button-row">
      <a class="button primary" href={cardHref(base, "negative-results", "concept")}>Negative results</a>
      <a class="button" href={withBase("/experiments/coverage/")}>Coverage</a>
    </div>
  </section>

  <section class="readable">
    <ul>
      {inRepoLines.map((line) => (
        <li>
          <a href={cardHref(base, `experiments/${line.id}`)}>{line.title}</a>
          {" — "}
          {oneLine(line.role)}
        </li>
      ))}
    </ul>
    <p class="side-panel-meta">None of this is a proof on a frontier system.</p>
  </section>
</SiteLayout>
