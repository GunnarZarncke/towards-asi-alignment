---
import SiteLayout from "../../layouts/SiteLayout.astro";
import FieldPreviewHub from "../../components/FieldPreviewHub.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<SiteLayout
  title="Field"
  description="AI safety and alignment: who published what, which problems depend on which, and the research programs."
>
  <section class="hero">
    <p class="eyebrow">Field</p>
    <h1>AI safety and alignment</h1>
    <p class="lede">Labs disagree on methods. They still share unsolved handoffs.</p>
  </section>

  <FieldPreviewHub base={base} />

  <p class="field-briefing-link readable">
    <a href={withBase("/field/v2/")}>Longer briefing</a>
    {" · "}
    <a href={withBase("/field/v1/")}>Archived v1 matrix</a>
  </p>
</SiteLayout>

<style>
  .field-briefing-link {
    margin-top: 1.75rem;
  }
</style>
