---
import { getEntry, render } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import FieldAgendaMatrix from "../../../components/FieldAgendaMatrix.astro";
import FieldEvidenceCatalog from "../../../components/FieldEvidenceCatalog.astro";
import FieldBridgeGraph from "../../../components/FieldBridgeGraph.astro";
import fieldV2 from "../../../data/field-v2.json";

const introEntry = await getEntry("field", "intro");
if (!introEntry) throw new Error("Missing site/src/content/field/intro.md");
const { Content: IntroContent } = await render(introEntry);

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const lifecycleOrder = ["specify", "construct", "identify", "certify", "preserve"];
const bridgesByRole = Object.fromEntries(lifecycleOrder.map((r) => [r, []]));
for (const b of fieldV2.bridges) {
  const role = b.lifecycleRole ?? "certify";
  if (!bridgesByRole[role]) bridgesByRole[role] = [];
  bridgesByRole[role].push(b);
}

const openByRole = Object.fromEntries(lifecycleOrder.map((r) => [r, []]));
for (const iface of fieldV2.openSpineInterfaces) {
  const role = iface.lifecycleRole ?? "construct";
  if (!openByRole[role]) openByRole[role] = [];
  openByRole[role].push(iface);
}

const phaseMeta = Object.fromEntries(
  (fieldV2.lifecyclePhases ?? []).map((p) => [p.id, p])
);
---

<SiteLayout
  title="Field"
  description={introEntry.data.description ?? "AI safety field map: agendas, bridge coverage matrix, lifecycle axis, and sourced evidence catalog."}
>
  <section class="hero">
    <p class="eyebrow">Field</p>
    <h1>AI safety and alignment</h1>
    <p class="lede">
      A map of research agendas and how they connect to the hard problems of the AI alignment field.
      {" "}
      <span class="v1-ref">Archived v1 matrix (no lifecycle or stance marks): <a href={withBase("/field/v1/")}>/field/v1/</a>.</span>
    </p>
  </section>

  <article class="field-intro prose-block">
    <IntroContent />
  </article>

  <section id="bridge-dependencies" class="bridge-graph-section readable">
    <h2>Bridge dependency map</h2>
    <p class="bridge-graph-lede">
      How this project's bridge assumptions (MB1–MB11) depend on one another, labeled in field nouns from the coverage matrix below.
    </p>
    <p class="bridge-graph-disclaimer side-panel-meta">
      This map shows logical and safety-case assembly dependencies among named bridge handoffs — not a proof that real systems satisfy them.
      Lean checks conditional structure when the bridges hold; field evidence, measurement, and deployment class still govern whether each handoff is reliable in practice.
    </p>
    <FieldBridgeGraph
      svgFile="field-graphs/bridge-dependencies-v2.svg"
      dotFile="field-graphs/bridge-dependencies-v2.dot"
    />
    <p class="side-panel-meta">
      Hub card: <a href={withBase("/cards/bridge-assumptions/")}>Bridge assumptions</a>
      {" · "}
      Formal spine: <a href={withBase("/lean/")}>Lean proof spine</a>
    </p>
  </section>

  <section id="lifecycle-axis" class="lifecycle-section readable">
    <h2>Lifecycle axis</h2>
    <p class="lifecycle-intro">{fieldV2.meta.lifecycleIntro}</p>
    {fieldV2.meta.lifecycleBridgeAssignmentNote ? (
      <p class="lifecycle-note">{fieldV2.meta.lifecycleBridgeAssignmentNote}</p>
    ) : null}
    {fieldV2.meta.lifecycleGapsNote ? (
      <p class="lifecycle-note lifecycle-gaps">{fieldV2.meta.lifecycleGapsNote}</p>
    ) : null}
    <p class="lifecycle-axis-line side-panel-meta">
      <strong>Axis:</strong> {fieldV2.meta.lifecycleAxis}
    </p>
    {lifecycleOrder.map((role) => {
      const phase = phaseMeta[role];
      const bridges = bridgesByRole[role] ?? [];
      const openInterfaces = openByRole[role] ?? [];
      if (!phase && bridges.length === 0 && openInterfaces.length === 0) return null;
      return (
        <div class="role-block">
          <h3>{phase?.label ?? role}</h3>
          {phase?.summary ? <p class="role-summary">{phase.summary}</p> : null}
          {bridges.length > 0 ? (
            <ul class="bridge-list">
              {bridges.map((b) => (
                <li class:list={[{ gravestone: b.gravestone }]}>
                  <strong>{b.noun}</strong> ({b.key})
                  {b.gravestone ? <span class="gravestone-tag">retired matrix bridge</span> : null}
                  {b.cardSlug ? (
                    <>
                      {" — "}
                      <a href={withBase(`/cards/${b.cardSlug}/`)}>card</a>
                    </>
                  ) : null}
                  {b.leanCrux ? (
                    <span class="lean-crux">
                      {" "}
                      · Lean: <code>{typeof b.leanCrux === "string" ? b.leanCrux : b.leanCrux.join(", ")}</code>
                    </span>
                  ) : null}
                </li>
              ))}
            </ul>
          ) : null}
          {openInterfaces.length > 0 ? (
            <ul class="open-interface-list">
              {openInterfaces.map((iface) => (
                <li>
                  <strong>{iface.title}</strong>
                  <span class="open-interface-tag">open spine interface</span>
                  {" — "}
                  <a href={withBase(iface.conceptCard)}>concept card</a>
                  {iface.leanProp ? (
                    <span class="lean-crux">
                      {" "}
                      · Lean: <code>{iface.leanProp}</code>
                    </span>
                  ) : null}
                  <p>{iface.summary}</p>
                </li>
              ))}
            </ul>
          ) : null}
        </div>
      );
    })}
  </section>

  <section id="specify-construct-instances" class="specify-construct-section readable">
    <h2>Specify / construct instances</h2>
    {fieldV2.meta.specifyConstructIntro ? (
      <p class="specify-construct-intro">{fieldV2.meta.specifyConstructIntro}</p>
    ) : null}
    {fieldV2.meta.specifyConstructPlaceholderNote ? (
      <p class="specify-construct-note side-panel-meta">{fieldV2.meta.specifyConstructPlaceholderNote}</p>
    ) : null}
    <div class="table-wrap">
      <table class="specify-construct-table">
        <thead>
          <tr>
            <th scope="col">Specify instance</th>
            <th scope="col">Lean</th>
            <th scope="col">Parameters</th>
            <th scope="col">Construction bet</th>
            <th scope="col">Lean</th>
            <th scope="col">Why paired</th>
            <th scope="col">References</th>
          </tr>
        </thead>
        <tbody>
          {(fieldV2.specifyConstructInstances ?? []).map((row) => {
            const p = row.specify?.params ?? {};
            const paramBits = [
              p.constituency ? "constituency" : null,
              p.extrapolation ? "extrapolation" : null,
              p.aggregation ? "aggregation" : null,
              p.openWorldCoverage ? "openWorldCoverage" : null,
              p.institutional ? "institutional" : null
            ].filter(Boolean);
            return (
              <tr>
                <td>
                  <a href={withBase(row.specify.card)}>{row.specify.title}</a>
                </td>
                <td><code>{row.specify.lean}</code></td>
                <td class="param-cell">
                  {paramBits.length > 0 ? paramBits.join(", ") : "—"}
                </td>
                <td>
                  <a href={withBase(row.construct.card)}>{row.construct.title}</a>
                  {row.construct.claimsExplicitBuilder === false ? (
                    <span class="bet-flag"> · no named builder</span>
                  ) : (
                    <span class="bet-flag"> · explicit builder claim</span>
                  )}
                </td>
                <td>
                  <code>{row.construct.lean}</code>
                  {row.construct.pair ? (
                    <>
                      <br />
                      <code class="pair-code">{row.construct.pair}</code>
                    </>
                  ) : null}
                </td>
                <td class="correspondence-cell">{row.correspondence}</td>
                <td class="refs-cell">
                  {(row.references ?? []).map((ref, i) => (
                    <>
                      {i > 0 ? <br /> : null}
                      <a href={ref.url.startsWith("http") ? ref.url : withBase(ref.url)}>{ref.label}</a>
                    </>
                  ))}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {(fieldV2.specifyConstructPeerRows ?? []).length > 0 ? (
      <>
        <h3>Peer outer targets (not ConstitutionalRule instances)</h3>
        <div class="table-wrap">
          <table class="specify-construct-table peer-table">
            <thead>
              <tr>
                <th scope="col">Specify / outer target</th>
                <th scope="col">Construction bet</th>
                <th scope="col">Note</th>
                <th scope="col">References</th>
              </tr>
            </thead>
            <tbody>
              {fieldV2.specifyConstructPeerRows.map((row) => (
                <tr>
                  <td><a href={withBase(row.specifyCard)}>{row.specifyTitle}</a></td>
                  <td><a href={withBase(row.constructCard)}>{row.constructTitle}</a></td>
                  <td class="correspondence-cell">{row.correspondence}</td>
                  <td class="refs-cell">
                    {(row.references ?? []).map((ref, i) => (
                      <>
                        {i > 0 ? <br /> : null}
                        <a href={ref.url.startsWith("http") ? ref.url : withBase(ref.url)}>{ref.label}</a>
                      </>
                    ))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ) : null}
    <p class="side-panel-meta">
      Open interfaces: <a href={withBase("/cards/alignment-target/")}>Alignment Target</a>
      {" · "}
      <a href={withBase("/cards/target-realization/")}>Target Realization</a>
      {" · "}
      <a href={withBase("/lean/")}>Lean spine</a>
    </p>
  </section>

  <FieldAgendaMatrix base={base} showStance={true} hubPath="/field/v2/" />

  <section id="adjacent-work" class="adjacent-section readable">
    <h2>Adjacent work: bearer admission</h2>
    {fieldV2.meta.adjacentWorkIntro ? (
      <p class="adjacent-intro">{fieldV2.meta.adjacentWorkIntro}</p>
    ) : null}
    {fieldV2.meta.adjacentWorkFirewall ? (
      <p class="adjacent-note adjacent-firewall">{fieldV2.meta.adjacentWorkFirewall}</p>
    ) : null}
    {fieldV2.meta.adjacentWorkPhenomenalityNote ? (
      <p class="adjacent-note">{fieldV2.meta.adjacentWorkPhenomenalityNote}</p>
    ) : null}
    <ul class="adjacent-list">
      {(fieldV2.adjacentWork ?? []).map((item) => (
        <li>
          <strong>{item.title}</strong>
          {item.carrier ? <span class="adjacent-carrier"> — {item.carrier}</span> : null}
          {item.bridges?.length ? (
            <span class="adjacent-bridges">
              {" "}
              · crux neighborhood: {item.bridges.join(", ")}
            </span>
          ) : null}
          {item.type ? <span class="adjacent-type"> · {item.type}</span> : null}
          {item.summary ? <p>{item.summary}</p> : null}
          {item.sources?.length ? (
            <p class="adjacent-sources">
              {item.sources.map((src, i) => (
                <span>
                  {i > 0 ? " · " : ""}
                  <a href={src.url}>{src.label}</a>
                </span>
              ))}
            </p>
          ) : null}
          {item.book ? <p class="adjacent-book side-panel-meta">Book: {item.book}</p> : null}
        </li>
      ))}
    </ul>
  </section>

  <FieldEvidenceCatalog base={base} showStance={true} />
</SiteLayout>

<style>
  .v1-ref {
    color: var(--color-muted, #64748b);
    font-size: 0.92em;
  }

  .prose-block,
  .field-intro {
    margin-top: 2rem;
    max-width: 48rem;
  }

  .field-intro :global(h2) {
    margin-top: 2rem;
    font-size: 1.35rem;
  }

  .field-intro :global(h2:first-child) {
    margin-top: 0;
  }

  .field-intro :global(p),
  .field-intro :global(li) {
    line-height: 1.6;
  }

  .field-intro :global(blockquote) {
    margin: 1.25rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--color-border, #c8d4e0);
    color: var(--color-muted, #4a5568);
    font-style: italic;
  }

  .field-intro :global(ul) {
    padding-left: 1.25rem;
  }

  .field-intro :global(a) {
    color: var(--color-link, #1a5276);
  }

  .bridge-graph-section {
    margin-top: 2.5rem;
    max-width: 52rem;
  }

  .bridge-graph-lede {
    margin: 0.5rem 0 0.75rem;
    line-height: 1.6;
  }

  .bridge-graph-disclaimer {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-border, #c8d4e0);
    background: var(--color-surface, #fafbfc);
  }

  .lifecycle-section {
    margin-top: 2.5rem;
    max-width: 52rem;
  }

  .lifecycle-intro {
    margin: 0.5rem 0 0.75rem;
    line-height: 1.6;
  }

  .lifecycle-note {
    margin: 0 0 0.75rem;
    line-height: 1.6;
    color: var(--color-muted, #4a5568);
    font-size: 0.96em;
  }

  .lifecycle-gaps {
    padding: 0.65rem 0.85rem;
    border-left: 3px solid var(--color-border, #c8d4e0);
    background: var(--color-surface, #fafbfc);
  }

  .lifecycle-axis-line {
    margin: 0 0 1.25rem;
  }

  .role-block {
    margin: 1.75rem 0;
  }

  .role-block h3 {
    margin-bottom: 0.35rem;
  }

  .role-summary {
    margin: 0 0 0.65rem;
    line-height: 1.6;
    color: var(--color-muted, #4a5568);
  }

  .bridge-list,
  .open-interface-list {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    line-height: 1.55;
  }

  .open-interface-tag {
    margin-left: 0.35rem;
    font-size: 0.85em;
    color: var(--color-muted, #64748b);
    font-style: italic;
  }

  .gravestone-tag {
    margin-left: 0.35rem;
    font-size: 0.85em;
    color: var(--color-muted, #64748b);
    font-style: italic;
  }

  li.gravestone {
    color: var(--color-muted, #4a5568);
  }

  .open-interface-list p {
    margin: 0.35rem 0 0;
    color: var(--color-muted, #4a5568);
    font-size: 0.95em;
    line-height: 1.5;
  }

  .lean-crux code {
    font-size: 0.9em;
  }

  .specify-construct-section {
    margin-top: 2.5rem;
    max-width: 100%;
  }

  .specify-construct-section .table-wrap {
    overflow-x: auto;
  }

  .specify-construct-intro {
    margin: 0.5rem 0 0.75rem;
    line-height: 1.6;
  }

  .specify-construct-note {
    margin: 0 0 1rem;
    max-width: 48rem;
    line-height: 1.5;
  }

  .specify-construct-table {
    font-size: 0.84rem;
    min-width: 64rem;
  }

  .specify-construct-table th,
  .specify-construct-table td {
    vertical-align: top;
    padding: 0.55rem 0.5rem;
  }

  .correspondence-cell,
  .refs-cell {
    max-width: 18rem;
    line-height: 1.45;
    color: var(--color-muted, #4a5568);
  }

  .param-cell {
    font-size: 0.82em;
    white-space: nowrap;
  }

  .bet-flag {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.85em;
    color: var(--color-muted, #64748b);
    font-style: italic;
  }

  .pair-code {
    font-size: 0.82em;
    color: var(--color-muted, #64748b);
  }

  .peer-table {
    margin-top: 0.75rem;
  }

  .specify-construct-section h3 {
    margin-top: 1.75rem;
    font-size: 1.1rem;
  }

  .adjacent-section {
    margin-top: 2.5rem;
    max-width: 52rem;
  }

  .adjacent-intro {
    margin: 0.5rem 0 0.75rem;
    line-height: 1.6;
  }

  .adjacent-note {
    margin: 0 0 0.75rem;
    line-height: 1.6;
    color: var(--color-muted, #4a5568);
    font-size: 0.96em;
  }

  .adjacent-firewall {
    padding: 0.65rem 0.85rem;
    border-left: 3px solid var(--color-border, #c8d4e0);
    background: var(--color-surface, #fafbfc);
  }

  .adjacent-list {
    margin: 1rem 0 0;
    padding-left: 1.25rem;
    line-height: 1.55;
  }

  .adjacent-list > li {
    margin-bottom: 1.25rem;
  }

  .adjacent-list p {
    margin: 0.35rem 0 0;
    color: var(--color-muted, #4a5568);
    font-size: 0.95em;
    line-height: 1.5;
  }

  .adjacent-carrier,
  .adjacent-bridges,
  .adjacent-type {
    color: var(--color-muted, #64748b);
    font-size: 0.92em;
  }

  .adjacent-sources {
    color: var(--color-text, #1a202c) !important;
  }

  .adjacent-book {
    margin-top: 0.25rem !important;
  }
</style>
