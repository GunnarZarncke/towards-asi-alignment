---
import { getEntry, render } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import FieldPreviewHub from "../../../components/FieldPreviewHub.astro";
import ParentCrumb from "../../../components/ParentCrumb.astro";

const introEntry = await getEntry("field", "intro");
if (!introEntry) throw new Error("Missing site/src/content/field/intro.md");
const { Content: IntroContent } = await render(introEntry);

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<SiteLayout
  title="Field"
  description={introEntry.data.description ?? "AI safety and alignment: who published what, which problems depend on which, and the research programs."}
>
  <section class="hero">
    <ParentCrumb parentHref={withBase("/field/")} parentLabel="Field" />
    <p class="eyebrow">Field</p>
    <h1>AI safety and alignment</h1>
    <p class="lede">Labs disagree on methods. They still share unsolved handoffs.</p>
  </section>

  <article class="field-intro prose-block readable">
    <IntroContent />
  </article>

  <FieldPreviewHub base={base} />

  <p class="field-footer readable">
    <a href={withBase("/glossary/")}>Glossary</a>
    {" · "}
    <a href={withBase("/field/v1/")}>Archived v1 matrix</a>
  </p>
</SiteLayout>

<style>
  .field-intro {
    margin-top: 1.75rem;
    max-width: 48rem;
  }

  .field-intro :global(h2) {
    margin-top: 2rem;
    font-size: 1.35rem;
  }

  .field-intro :global(p),
  .field-intro :global(li) {
    line-height: 1.6;
  }

  .field-intro :global(blockquote) {
    margin: 1.25rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--color-border, #c8d4e0);
    color: var(--color-muted, #4a5568);
    font-style: italic;
  }

  .field-footer {
    margin-top: 1.75rem;
  }
</style>
