---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import FundingStateIcon from "../../components/FundingStateIcon.astro";
import FundingDependencyGraph from "../../components/FundingDependencyGraph.astro";
import { cardHrefForCard } from "../../lib/site-urls";
import {
  formatUsd,
  formatFte
} from "../../lib/funding-state";
import {
  buildFundingGraphPayload,
  fundingNodeLabel
} from "../../lib/funding-graph/build-payload";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const scheduleCallUrl = "https://calendly.com/g-zarncke";

const allCards = await getCollection("cards");
const fundingCards = allCards
  .filter((c) => c.data.type === "funding")
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const bySlug = new Map(
  fundingCards.map((c) => [c.id.replace(/^funding\//, ""), c])
);

const graphPayload = buildFundingGraphPayload(base, fundingCards);

function resolveDepCard(depId: string) {
  const slug = depId.replace(/^funding\//, "");
  return bySlug.get(slug) ?? allCards.find((entry) => entry.id === depId || entry.id === `funding/${slug}`);
}

const dependencyRows = fundingCards
  .filter((card) => card.data.dependsOn.length > 0)
  .sort((a, b) =>
    fundingNodeLabel(a.id.replace(/^funding\//, "")).localeCompare(
      fundingNodeLabel(b.id.replace(/^funding\//, ""))
    )
  )
  .map((card) => {
    const slug = card.id.replace(/^funding\//, "");
    return {
      slug,
      href: cardHrefForCard(base, card),
      deps: card.data.dependsOn
        .map((depId) => resolveDepCard(depId))
        .filter(Boolean)
        .map((dep) => ({
          slug: dep!.id.replace(/^funding\//, ""),
          href: cardHrefForCard(base, dep!),
          label: fundingNodeLabel(dep!.id.replace(/^funding\//, ""))
        }))
    };
  });

function costLine(card: (typeof fundingCards)[number]) {
  if (card.data.costLabel) return card.data.costLabel;
  if (card.data.costUsd == null) return null;
  if (card.data.costUsdMax != null && card.data.costUsdMax !== card.data.costUsd) {
    return `${formatUsd(card.data.costUsd)} – ${formatUsd(card.data.costUsdMax)}`;
  }
  return formatUsd(card.data.costUsd);
}
---

<SiteLayout
  title="Funding opportunities"
  description="Open funding asks for agent discovery, oversight testbeds, corrigibility measurement, observability infrastructure, and alignment field maps."
>
  <section class="hero">
    <p class="eyebrow">Funding</p>
    <h1>Funding opportunities</h1>
    <p class="lede">
      These funds buy agent discovery in real traces, reproducible multi-principal and competitive-lab testbeds,
      corrigibility measurement on deployment-shaped systems, shared observability infrastructure, and field maps
      that name which alignment job a dollar is purchasing.
    </p>
    <p class="button-row">
      <a class="button primary" href="#all-opportunities">Compare project cards</a>
      <a class="button" href={scheduleCallUrl} target="_blank" rel="noopener noreferrer">Schedule a call</a>
      <a class="button" href={withBase("/paths/funder-policy/")}>Funder reading path</a>
    </p>
  </section>

  <section class="diagram-section content-card">
    <h2>Dependencies</h2>
    <p class="side-panel-meta">
      Block graph from each card’s <code>dependsOn</code> field — arrows run from dependency to dependent project.
      Parallel projects share no staffing constraint.
    </p>
    <FundingDependencyGraph payload={graphPayload} dependencyRows={dependencyRows} />
  </section>

  <section class="card-list" id="all-opportunities">
    <h2>All opportunities</h2>
    <ul class="funding-list">
      {fundingCards.map((card) => {
        const href = cardHrefForCard(base, card);
        const cost = costLine(card);
        const team = formatFte(card.data.fte, card.data.fteMax);
        return (
          <li class="funding-list-item content-card">
            <div class="funding-list-head">
              <h3><a href={href}>{card.data.title}</a></h3>
              <span class="diagram-icons">
                {card.data.fundingState && (
                  <FundingStateIcon axis="funding" state={card.data.fundingState} />
                )}
                {card.data.doneState && (
                  <FundingStateIcon axis="done" state={card.data.doneState} />
                )}
              </span>
            </div>
            <p>{card.data.summary}</p>
            <p class="side-panel-meta">
              {cost && <span>{cost}</span>}
              {card.data.durationMonths != null && (
                <span>{cost ? " · " : ""}{card.data.durationMonths} mo</span>
              )}
              {card.data.fundedUsd != null && (
                <span> · granted {formatUsd(card.data.fundedUsd)}</span>
              )}
              {card.data.remainingUsd != null && (
                <span> · ~{formatUsd(card.data.remainingUsd)} to finish</span>
              )}
              {team && <span> · {team}</span>}
            </p>
            {card.data.roles.length > 0 && (
              <p class="funding-list-roles side-panel-meta">Roles: {card.data.roles.join(" · ")}</p>
            )}
          </li>
        );
      })}
    </ul>
  </section>
</SiteLayout>

<style>
  .diagram-icons {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
  }

  .funding-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .funding-list-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .funding-list-head h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }

  .funding-list-item p {
    margin: 0.25rem 0 0;
  }

  .funding-list-roles {
    margin-top: 0.35rem;
    line-height: 1.45;
  }
</style>
