---
import SiteLayout from "../../layouts/SiteLayout.astro";
import leanChecks from "../../data/lean-checks.json";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const firstCheck = leanChecks.checks[0];
---

<SiteLayout
  title="Lean"
  description="Field questions Lean actually checked — projections and separations on a finite domain."
>
  <section class="hero">
    <p class="eyebrow">Lean</p>
    <h1>Lean</h1>
    <div class="button-row">
      <a class="button primary" href={withBase(`/lean/check/${firstCheck.slug}/`)}>Does this capture corrigibility?</a>
      <a class="button" href={withBase("/lean/spine/")}>Full spine</a>
    </div>
  </section>

  <section class="readable">
    <ul>
      {leanChecks.checks.map((check) => (
        <li>
          <a href={withBase(`/lean/check/${check.slug}/`)}>{check.question}</a>
        </li>
      ))}
    </ul>
    <p class="side-panel-meta">These checks do not prove real systems are aligned.</p>
  </section>
</SiteLayout>
