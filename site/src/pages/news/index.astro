---
import { getCollection } from "astro:content";
import fieldNewsIndex from "../../data/field-news.json";
import SiteLayout from "../../layouts/SiteLayout.astro";
import LinkIndicator from "../../components/LinkIndicator.astro";
import { cardHref as buildCardHref } from "../../lib/site-urls";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const cardHref = (id: string) => buildCardHref(base, id);

const items = [...fieldNewsIndex].sort((a, b) => b.date.localeCompare(a.date));
const [newestNews, ...olderNews] = items;

const cards = await getCollection("cards");
const versions = cards
  .filter((card) => card.data.type === "release" && card.id !== "releases-updates" && card.data.releasedAt)
  .sort((a, b) => (b.data.releasedAt ?? "").localeCompare(a.data.releasedAt ?? ""));
const [newestRelease, ...olderReleases] = versions;

const kindLabel: Record<string, string> = {
  incident: "Incident",
  "eval-result": "Evaluation",
  research: "Research",
  policy: "Policy",
  anecdote: "Anecdote"
};
---

<SiteLayout
  title="News"
  description="Field incidents and manuscript releases — orientation only, not manuscript canon."
>
  <section class="hero">
    <p class="eyebrow">News</p>
    <h1>News</h1>
    <p class="side-panel-meta">
      Not part of the book.
      {" "}
      <a href={withBase("/feed.xml")}>RSS</a><LinkIndicator kind="rss" />
    </p>
  </section>

  <div class="news-unfolds">
    <details open class="news-unfold">
      <summary>Field news</summary>
      {newestNews && (
        <article class="news-item">
          <p class="news-meta">
            <time datetime={newestNews.eventDate ?? newestNews.date}>{newestNews.eventDate ?? newestNews.date}</time>
            {" · "}
            <span>{kindLabel[newestNews.kind] ?? newestNews.kind}</span>
          </p>
          <h2><a href={cardHref(newestNews.card)}>{newestNews.title}</a></h2>
          <p>{newestNews.hook}</p>
        </article>
      )}
      {olderNews.length > 0 && (
        <details>
          <summary>More field news</summary>
          <ul class="news-list">
            {olderNews.map((item) => (
              <li class="news-item">
                <p class="news-meta">
                  <time datetime={item.eventDate ?? item.date}>{item.eventDate ?? item.date}</time>
                  {" · "}
                  <span>{kindLabel[item.kind] ?? item.kind}</span>
                </p>
                <h2><a href={cardHref(item.card)}>{item.title}</a></h2>
                <p>{item.hook}</p>
              </li>
            ))}
          </ul>
        </details>
      )}
    </details>

    <details open class="news-unfold" id="releases">
      <summary>Releases</summary>
      {newestRelease && (
        <article class="news-item">
          <h2><a href={cardHref(newestRelease.id)}>{newestRelease.data.title}</a></h2>
          <p>{newestRelease.data.summary}</p>
        </article>
      )}
      {olderReleases.length > 0 && (
        <details>
          <summary>Older releases</summary>
          <ul class="news-list">
            {olderReleases.map((card) => (
              <li class="news-item">
                <h2><a href={cardHref(card.id)}>{card.data.title}</a></h2>
                <p>{card.data.summary}</p>
              </li>
            ))}
          </ul>
        </details>
      )}
      <p class="side-panel-meta"><a href={withBase("/updates/")}>Full release list</a></p>
    </details>
  </div>
</SiteLayout>

<style>
  .news-unfolds {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 720px) {
    .news-unfolds {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .news-unfold {
    border: 1px solid var(--color-border, #c8d4e0);
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }

  .news-unfold > summary {
    font-weight: 600;
    cursor: pointer;
  }

  .news-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .news-item {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border-subtle, #e5e5e5);
  }

  .news-item h2 {
    font-size: 1.05rem;
    margin: 0.25rem 0 0.4rem;
  }

  .news-meta {
    font-size: 0.85rem;
    opacity: 0.85;
    margin: 0;
  }
</style>
