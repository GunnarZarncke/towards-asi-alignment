---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { bookHref } from "../../lib/site-urls";
import notation from "../../data/notation.json";

const base = import.meta.env.BASE_URL;
const totalSymbols = notation.reduce((n: number, section: { entries: unknown[] }) => n + section.entries.length, 0);
---

<SiteLayout
  title="Notation"
  description="Symbol index for the manuscript, generated from metadata/notation.yml — mirrors Appendix A."
>
  <section class="hero">
    <p class="eyebrow">Appendix A on the web</p>
    <h1>Notation index</h1>
    <p class="lede">
      {totalSymbols} symbols across {notation.length} sections, generated from <code>metadata/notation.yml</code>.
      Each row links to the chapter that defines the symbol.
    </p>
  </section>

  {notation.map((section: { title: string; entries: { symbol: string; definition: string; home: string; chapterId: string | null }[] }) => (
    <section class="readable">
      <h2>{section.title}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Symbol</th>
              <th>Definition</th>
              <th>Home</th>
            </tr>
          </thead>
          <tbody>
            {section.entries.map((entry) => (
              <tr>
                <td>{entry.symbol}</td>
                <td>{entry.definition}</td>
                <td>
                  {entry.chapterId ? <a href={bookHref(base, entry.chapterId)}>{entry.home}</a> : entry.home}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</SiteLayout>
