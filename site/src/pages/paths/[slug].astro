---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Badge from "../../components/Badge.astro";
import ConceptCardLink from "../../components/ConceptCardLink.astro";
import LinkIndicator from "../../components/LinkIndicator.astro";
import PathReadNext from "../../components/PathReadNext.astro";
import { pathHref } from "../../lib/site-urls";
import { getReadingPath, readingPathIds, type ReadingPathStep } from "../../lib/reading-paths";
import {
  resolveReadingPathStep,
  type ResolvedReadingPathStep
} from "../../lib/reading-path-steps";
import { buildReadNextConfig } from "../../lib/read-next";
import {
  defaultPrimaryLabel,
  resolveSpotlightTarget
} from "../../lib/reading-path-spotlight";

export async function getStaticPaths() {
  return readingPathIds().map((slug) => ({
    params: { slug },
    props: { slug }
  }));
}

const { slug } = Astro.props;
const path = getReadingPath(slug);
if (!path) {
  return Astro.redirect(`${import.meta.env.BASE_URL}paths/`);
}

const markdown = await createMarkdownProcessor();
const { code: bodyHtml } = await markdown.render(path.body);

const cards = await getCollection("cards");
const base = import.meta.env.BASE_URL;
const withBase = (route: string) => `${base}${route.replace(/^\/+/, "")}`;
const stepContext = { base, cards, withBase };
const readNextConfig = buildReadNextConfig(stepContext);
const spotlightContext = { base, cards, withBase };

const resolveStep = (step: ReadingPathStep): ResolvedReadingPathStep | null =>
  resolveReadingPathStep(step, stepContext);

const resolvedSteps = path.steps
  .map((step) => ({ step, resolved: resolveStep(step) }))
  .filter((entry): entry is { step: ReadingPathStep; resolved: NonNullable<ReturnType<typeof resolveStep>> } =>
    entry.resolved !== null
  );
---

<SiteLayout title={path.title} description={path.summary}>
  <section class="hero">
    <p class="eyebrow">{path.audience}</p>
    <h1>{path.title}</h1>
    <p class="lede">{path.summary}</p>
  </section>

  <PathReadNext config={readNextConfig} preferredPathId={path.id} />

  {path.featuredSpotlight && (
    <section class="callout worked-example readable">
      <p class="eyebrow">{path.featuredSpotlight.eyebrow}</p>
      <h2>{path.featuredSpotlight.title}</h2>
      <p>{path.featuredSpotlight.blurb}</p>
      <p class="button-row">
        <a
          class="button primary"
          href={resolveSpotlightTarget(path.featuredSpotlight, spotlightContext)}
          target={path.featuredSpotlight.kind === "demo" ? "_blank" : undefined}
          rel={path.featuredSpotlight.kind === "demo" ? "noopener noreferrer" : undefined}
        >
          {defaultPrimaryLabel(path.featuredSpotlight, spotlightContext)}
          {path.featuredSpotlight.kind === "demo" && <LinkIndicator kind="newtab" />}
        </a>
        {path.featuredSpotlight.secondary && (
          <a
            class="button"
            href={resolveSpotlightTarget(path.featuredSpotlight.secondary, spotlightContext)}
            target={path.featuredSpotlight.secondary.kind === "demo" ? "_blank" : undefined}
            rel={path.featuredSpotlight.secondary.kind === "demo" ? "noopener noreferrer" : undefined}
          >
            {path.featuredSpotlight.secondary.label}
            {path.featuredSpotlight.secondary.kind === "demo" && <LinkIndicator kind="newtab" />}
          </a>
        )}
      </p>
    </section>
  )}

  <section class="content-card readable" set:html={bodyHtml} />

  <section>
    <h2>Read in this order</h2>
    <p class="reading-list-intro">
      Cards, chapter toys, experiment lines, and book chapters — curated for this audience. Experiments are
      sanity checks only; negative results are part of the reading.
    </p>
    <ol class="reading-list">
      {resolvedSteps.map(({ resolved }) => (
        <li class="card reading-step">
          <div class="badge-row">
            {resolved.badges.map((badge) => (
              <Badge label={badge.label} variant={badge.variant} href={badge.href} />
            ))}
          </div>
          <h3>
            {"cardSlug" in resolved && resolved.cardSlug ? (
              <ConceptCardLink
                href={resolved.href}
                slug={resolved.cardSlug}
                logoSize={40}
              >
                {resolved.title}
              </ConceptCardLink>
            ) : (
              <a
                href={resolved.href}
                target={resolved.newTab ? "_blank" : undefined}
                rel={resolved.newTab ? "noopener noreferrer" : undefined}
              >
                {resolved.title}
                {resolved.newTab && <LinkIndicator kind="newtab" />}
              </a>
            )}
          </h3>
          <p>{resolved.summary}</p>
        </li>
      ))}
    </ol>
  </section>

  <p class="button-row">
    <a class="button" href={withBase("/demos/")}>All chapter toys</a>
    <a class="button" href={withBase("/experiments/")}>All experiment lines</a>
  </p>
  {path.id === "researcher-applied" && (
    <p class="readable"><a href={pathHref(base, "researcher-formal")}>Continue to Researcher — Formal</a></p>
  )}
  {path.id === "researcher-formal" && (
    <p class="readable"><a href={pathHref(base, "researcher-applied")}>Start with Researcher — Applied</a></p>
  )}
</SiteLayout>

<style>
  .worked-example {
    margin-bottom: 2rem;
  }

  .worked-example h2 {
    margin-top: 0.35rem;
  }

  .reading-list-intro {
    color: var(--color-muted);
    margin-top: 0;
  }

  .reading-list {
    list-style: none;
    padding: 0;
    counter-reset: reading-step;
  }

  .reading-step {
    counter-increment: reading-step;
    position: relative;
    padding-left: 2.5rem;
  }

  .reading-step::before {
    content: counter(reading-step);
    position: absolute;
    left: 0;
    top: 1rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    display: grid;
    place-items: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-muted);
  }
</style>
