---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PathRelationshipDiagram from "../../components/PathRelationshipDiagram.astro";
import { pathHref } from "../../lib/site-urls";
import { getReadingPaths, type ReadingPathStep } from "../../lib/reading-paths";
import { resolveSpotlightTarget } from "../../lib/reading-path-spotlight";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const paths = getReadingPaths();
const spotlightContext = {
  base,
  cards: [],
  withBase
};

const stepSummary = (steps: ReadingPathStep[]) => {
  const counts = steps.reduce(
    (acc, step) => {
      acc[step.kind] = (acc[step.kind] ?? 0) + 1;
      return acc;
    },
    {} as Record<string, number>
  );
  const parts: string[] = [];
  if (counts.card) parts.push(`${counts.card} cards`);
  if (counts.demo) parts.push(`${counts.demo} ${counts.demo === 1 ? "toy" : "toys"}`);
  if (counts.experiment) parts.push(`${counts.experiment} experiment${counts.experiment === 1 ? "" : "s"}`);
  if (counts.book) parts.push(`${counts.book} chapters`);
  if (counts.lean) parts.push(`${counts.lean} Lean`);
  return parts.join(" · ");
};
---

<SiteLayout title="Guided Tour" description="Guided reading paths through the companion site.">
  <section class="hero">
    <p class="eyebrow">Guided tour</p>
    <h1>Guided Tour</h1>
    <p class="lede">
      With 48 chapters and dense formalism, orientation matters. Pick the path closest to your role;
      each one gives an ordered reading list — concept cards, chapter toys, experiment lines, and book chapters.
    </p>
    <p class="button-row">
      <a class="button primary" href={withBase("/faq/")}>FAQ</a>
      <a class="button" href={withBase("/book/")}>Book index</a>
    </p>
  </section>

  <section class="callout readable path-diagram">
    <h2>How paths relate</h2>
    <p class="diagram-caption">Start at the center, branch by role, deepen as needed.</p>
    <PathRelationshipDiagram paths={paths} base={base} />
    <p>
      All paths begin with <strong>what the book is not claiming</strong>. Researchers and engineers can merge paths;
      philosophers often skip formal Lean until the basin and bearer questions land.
    </p>
  </section>

  <section>
    <h2>Choose a path</h2>
    <div class="grid">
      {paths.map((path) => (
        <article class="card">
          <h3><a href={pathHref(base, path.id)}>{path.title}</a></h3>
          <p><strong>{path.audience}</strong></p>
          <p>{path.summary}</p>
          <p class="side-panel-meta">{path.steps.length} steps · {stepSummary(path.steps)}</p>
          {path.featuredSpotlight && (
            <p class="side-panel-meta">
              <a href={resolveSpotlightTarget(path.featuredSpotlight, spotlightContext)}>
                Featured: {path.featuredSpotlight.title}
              </a>
            </p>
          )}
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .path-diagram {
    margin-bottom: 2rem;
  }

  .diagram-caption {
    margin-top: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>
