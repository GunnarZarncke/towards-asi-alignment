---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import PathReadNext from "../../components/PathReadNext.astro";
import { firstEssayHref, pathHref } from "../../lib/site-urls";
import { getReadingPaths, type ReadingPathStep } from "../../lib/reading-paths";
import { buildReadNextConfig } from "../../lib/read-next";
import { resolveSpotlightTarget } from "../../lib/reading-path-spotlight";
import LinkIndicator from "../../components/LinkIndicator.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const paths = getReadingPaths();
const cards = await getCollection("cards");
const readNextConfig = buildReadNextConfig({ base, cards, withBase });
const spotlightContext = {
  base,
  cards,
  withBase
};

const stepSummary = (steps: ReadingPathStep[]) => {
  const counts = steps.reduce(
    (acc, step) => {
      acc[step.kind] = (acc[step.kind] ?? 0) + 1;
      return acc;
    },
    {} as Record<string, number>
  );
  const parts: string[] = [];
  if (counts.card) parts.push(`${counts.card} cards`);
  if (counts.demo) parts.push(`${counts.demo} ${counts.demo === 1 ? "toy" : "toys"}`);
  if (counts.experiment) parts.push(`${counts.experiment} experiment${counts.experiment === 1 ? "" : "s"}`);
  if (counts.book) parts.push(`${counts.book} chapters`);
  if (counts.lean) parts.push(`${counts.lean} Lean`);
  return parts.join(" · ");
};
---

<SiteLayout title="Guided Tour" description="Role-based reading paths and a chapter dependency graph.">
  <section class="hero">
    <p class="eyebrow">Guided Tour</p>
    <h1>Guided Tour</h1>
    <p class="lede">
      If you have not picked a role yet, read the essays first. Then choose a path below.
      Role paths stay for researchers, engineers, funders, and philosophers.
    </p>
    <p class="button-row">
      <a class="button primary" href={firstEssayHref(base)}>Story-shaped start</a>
      <a class="button" href={withBase("/paths/chapter-reading-graph/")}>Chapter graph</a>
    </p>
  </section>

  <PathReadNext config={readNextConfig} />

  <section>
    <div class="grid">
      {paths.map((path) => (
        <article class="card">
          <h3><a href={pathHref(base, path.id)}>{path.title}</a></h3>
          <p><strong>{path.audience}</strong></p>
          <p>{path.summary}</p>
          <p class="side-panel-meta">{path.steps.length} steps · {stepSummary(path.steps)}</p>
          {path.companionLink && (
            <p class="side-panel-meta">
              <a href={withBase(path.companionLink.href)}>{path.companionLink.label}</a>
            </p>
          )}
          {path.featuredSpotlight && (
            <p class="side-panel-meta">
              <a
                href={resolveSpotlightTarget(path.featuredSpotlight, spotlightContext)}
                target={path.featuredSpotlight.kind === "demo" ? "_blank" : undefined}
                rel={path.featuredSpotlight.kind === "demo" ? "noopener noreferrer" : undefined}
              >
                Featured: {path.featuredSpotlight.title}
                {path.featuredSpotlight.kind === "demo" && <LinkIndicator kind="newtab" />}
              </a>
            </p>
          )}
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
