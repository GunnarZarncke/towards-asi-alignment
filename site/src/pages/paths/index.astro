---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const PATH_ORDER = [
  "generalist",
  "philosopher",
  "researcher-applied",
  "researcher-formal",
  "engineer-evals",
  "funder-policy"
];

const paths = (await getCollection("paths")).sort(
  (a, b) => PATH_ORDER.indexOf(a.id) - PATH_ORDER.indexOf(b.id)
);
---

<SiteLayout title="Guided Tour" description="Guided reading paths through the companion site.">
  <section class="hero">
    <p class="eyebrow">Guided tour</p>
    <h1>Guided Tour</h1>
    <p class="lede">
      With 48 chapters and dense formalism, orientation matters. Pick the path closest to your role;
      each one states what you will learn, how long it takes, and an ordered card list—no prior jargon required.
    </p>
    <p class="button-row">
      <a class="button primary" href={withBase("/faq/")}>FAQ</a>
      <a class="button" href={withBase("/book/")}>Book index</a>
    </p>
  </section>

  <section class="callout readable path-diagram">
    <h2>How paths relate</h2>
    <p class="diagram-caption">Start at the center, branch by role, deepen as needed.</p>
    <div class="path-flow" aria-hidden="true">
      <div class="path-node path-node-center">New reader</div>
      <div class="path-row">
        <a class="path-node" href={withBase("/paths/generalist/")}>Generalist</a>
        <a class="path-node" href={withBase("/paths/philosopher/")}>Philosopher</a>
        <a class="path-node" href={withBase("/paths/funder-policy/")}>Funder / policy</a>
      </div>
      <div class="path-row">
        <a class="path-node" href={withBase("/paths/researcher-applied/")}>Researcher — applied</a>
        <span class="path-arrow">→</span>
        <a class="path-node" href={withBase("/paths/researcher-formal/")}>Researcher — formal</a>
      </div>
      <div class="path-row">
        <a class="path-node" href={withBase("/paths/engineer-evals/")}>Engineer / evals</a>
        <span class="path-note">often pairs with Appendix D worked example</span>
      </div>
    </div>
    <p>
      All paths begin with <strong>what the book is not claiming</strong>. Researchers and engineers can merge paths;
      philosophers often skip formal Lean until the basin and bearer questions land.
    </p>
  </section>

  <div class="grid">
    {paths.map((path) => (
      <article class="card">
        <h3><a href={withBase(`/paths/${path.id}/`)}>{path.data.title}</a></h3>
        <p><strong>{path.data.audience}</strong></p>
        <p>{path.data.summary}</p>
        {path.data.featuredLean && (
          <p class="side-panel-meta"><a href={withBase("/lean/")}>Includes Lean proof spine</a></p>
        )}
        {path.data.featuredWorkedExample && (
          <p class="side-panel-meta"><a href={withBase("/book/appd/")}>Includes BioShield worked example</a></p>
        )}
      </article>
    ))}
  </div>
</SiteLayout>

<style>
  .path-diagram {
    margin-bottom: 2rem;
  }

  .diagram-caption {
    margin-top: 0;
    color: var(--muted, #666);
    font-size: 0.95rem;
  }

  .path-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem 0;
    font-size: 0.92rem;
  }

  .path-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
  }

  .path-node {
    border: 1px solid var(--border, #ccc);
    border-radius: 0.5rem;
    padding: 0.45rem 0.75rem;
    background: var(--surface, #fafafa);
    text-decoration: none;
    color: inherit;
  }

  a.path-node:hover {
    border-color: var(--accent, #336);
  }

  .path-node-center {
    font-weight: 600;
    background: var(--accent-soft, #eef2ff);
  }

  .path-arrow {
    opacity: 0.6;
  }

  .path-note {
    font-size: 0.85rem;
    color: var(--muted, #666);
    font-style: italic;
  }
</style>
