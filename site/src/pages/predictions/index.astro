---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import PredictionsGaussIcon from "../../components/PredictionsGaussIcon.astro";
import PredictionsGraphPlaceholder from "../../components/PredictionsGraphPlaceholder.astro";
import PredictionMarketPanel from "../../components/PredictionMarketPanel.astro";
import predictions from "../../data/predictions.json";
import { bookFullHref, cardHrefForCard } from "../../lib/site-urls";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const allCards = await getCollection("cards");
const predictionCards = allCards
  .filter(
    (c) =>
      c.data.type === "prediction" &&
      !c.data.predictionOverview &&
      !c.data.predictionExternal
  )
  .sort((a, b) => (a.data.predictionNumber ?? 0) - (b.data.predictionNumber ?? 0));

const relatedForecasts = predictions.relatedForecasts ?? [];
const externalFactors = predictions.externalFactors ?? [];

function metaculusQuestionId(url: string): number | undefined {
  const match = url.match(/metaculus\.com\/questions\/(\d+)/i);
  return match ? Number(match[1]) : undefined;
}

function collapseNote(note?: string): string {
  return (note ?? "").replace(/\s+/g, " ").trim();
}

const relatedForecastPanels = [
  ...externalFactors.map((factor) => ({
    id: factor.id,
    shortTitle: factor.shortQuestion || factor.title,
    href: factor.url,
    embedId: factor.embedId ?? metaculusQuestionId(factor.url),
    note: collapseNote(factor.note),
    badge: "external" as const
  })),
  ...relatedForecasts.map((item) => ({
    id: item.id,
    shortTitle: item.title,
    href: item.url,
    embedId: item.embedId ?? metaculusQuestionId(item.url),
    note: collapseNote(item.note),
    badge: "related" as const
  }))
];

const overviewCard = allCards.find(
  (c) => c.data.type === "prediction" && c.data.predictionOverview
);

const purpose = predictions.purpose?.replace(/\s+/g, " ").trim() ?? "";
const cardByNumber = new Map(
  predictionCards.map((card) => [card.data.predictionNumber ?? 0, card])
);
const listingStatusLabel: Record<string, string> = {
  draft: "Draft",
  "funding-gated": "Funding-gated",
  "ready-to-list": "Ready to list",
  listed: "Listed",
  "resolved-yes": "Resolved YES",
  "resolved-no": "Resolved NO",
  "resolved-other": "Resolved OTHER"
};
const graph = predictions.graphPlaceholder ?? {
  title: "Safety-case context, not a doom product",
  blurb:
    "These contracts price operational milestones. An external Metaculus forecast prices institutional pause capacity. Neither is a safety-case probability, and their product is not a bound on catastrophe."
};
const aggregation = predictions.aggregation;
const appendixFullHref = bookFullHref(base, "appP");
const aggregationHref = aggregation?.appendixAnchor
  ? `${appendixFullHref}#${aggregation.appendixAnchor}`
  : appendixFullHref;
---

<SiteLayout
  title="Predictions"
  description={purpose || "2027 contracts on whether published methods meet frozen operational bars."}
>
  <section class="hero">
    <p class="eyebrow predictions-eyebrow">
      <PredictionsGaussIcon class="eyebrow-icon" title="" />
      <span>2027 contracts</span>
    </p>
    <h1>Predictions</h1>
    <p class="lede">{purpose}</p>
    <div class="button-row">
      {
        overviewCard && (
          <a class="button primary" href={cardHrefForCard(base, overviewCard)}>
            Catalog overview
          </a>
        )
      }
      <a class="button" href={appendixFullHref}>Appendix H (full)</a>
      <a class="button" href={predictions.registry?.site ?? "https://ai-safety-claims.com/"}>Claims registry</a>
      <a class="button" href={withBase("/cards/appendix/appB/")}>Bridge crosswalk</a>
      <a class="button" href={withBase("/predictions/safety-case/")}>Safety-case odds</a>
      <a class="button" href={withBase("/cards/funding/prediction-evaluation-program/")}>Fund evaluations</a>
    </div>
  </section>

  <PredictionsGraphPlaceholder title={graph.title} blurb={graph.blurb} />

  {
    aggregation && (
      <section class="predictions-aggregation readable" aria-labelledby="predictions-aggregation-heading">
        <h2 id="predictions-aggregation-heading">{aggregation.title}</h2>
        <p>{aggregation.blurb}</p>
        <p class="aggregation-note">
          <a href={aggregationHref}>Read the safety-case sections in Appendix H</a>
          {" "}— {aggregation.hubNote || "three evidence levels, the F/R/U odds update, and why Market 14 is not an override probability."}
        </p>
      </section>
    )
  }

  <section class="predictions-market-grid predictions-panels-section" aria-label="AI alignment subproblem markets">
    <h2 class="section-heading">AI alignment subproblem markets</h2>
    <p class="listing-note">
      These are candidate contracts, not live markets. “Funding-gated” means that a credible YES route needs an unfunded independent evaluation or challenge; it does not mean the technical claim is false.
      Numeric bars and scored outcomes for catalog markets 1–13 and 15–18 live on the versioned page in the <a href={predictions.registry?.site ?? "https://ai-safety-claims.com/"}>claims registry</a>
      {predictions.registry?.snapshotTag
        ? <> (resolution snapshot <code>{predictions.registry.snapshotTag}</code>).</>
        : <> (not a resolution source until an independent host tags a snapshot).</>}
      {" "}Market 14 and Phase 4 drafts 19–21 list from their appendix boxes only.
    </p>
    <div class="market-panels">
      {
        (predictions.markets ?? []).map((market) => {
          const card = cardByNumber.get(market.number);
          if (!card) return null;
          const status = market.marketStatus ?? "draft";
          return (
            <PredictionMarketPanel
              number={market.number}
              shortTitle={market.shortTitle || market.title}
              href={cardHrefForCard(base, card)}
              listingStatus={status}
              listingLabel={listingStatusLabel[status] ?? status}
              embedId={market.metaculusEmbedId}
              registryHref={
                market.number === 14
                  ? undefined
                  : (market.registryContractUrl || market.registryOutcomeUrl || predictions.registry?.site)
              }
              registryLabel={
                market.number === 14
                  ? undefined
                  : market.registryContractUrl
                    ? "Resolution criteria"
                    : "Claims registry (no contract yet)"
              }
            />
          );
        })
      }
    </div>
  </section>

  {
    relatedForecastPanels.length > 0 && (
      <section class="predictions-related predictions-panels-section" aria-labelledby="predictions-related-heading">
        <h2 id="predictions-related-heading">Related forecasts</h2>
        <p class="external-intro">
          Live Metaculus questions, including the external pause factor. Not subproblem markets and not inputs to the safety-case model.
        </p>
        <div class="market-panels">
          {relatedForecastPanels.map((item) => (
            <PredictionMarketPanel
              shortTitle={item.shortTitle}
              href={item.href}
              embedId={item.embedId}
              note={item.note || undefined}
              badge={item.badge}
              externalLink
            />
          ))}
        </div>
      </section>
    )
  }
</SiteLayout>

<style>
  .predictions-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .eyebrow-icon {
    width: 1.35rem;
    height: auto;
    color: color-mix(in srgb, #c2410c 75%, var(--color-text));
  }

  .section-heading {
    font-size: 1.15rem;
    margin: 0 0 1rem;
  }

  .listing-note {
    margin: -0.35rem 0 1rem;
    font-size: 0.9rem;
    line-height: 1.45;
    opacity: 0.85;
  }

  .predictions-panels-section {
    width: 100%;
    max-width: none;
    margin-bottom: 2.5rem;
  }

  .predictions-related.predictions-panels-section {
    margin-bottom: 2rem;
  }

  .market-panels {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  /* Metaculus desktop charts need ~33rem+ iframe width; cap at two columns. */
  @media (min-width: 960px) {
    .market-panels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .predictions-aggregation {
    max-width: var(--max-readable);
    margin-bottom: 2rem;
  }

  .predictions-aggregation h2,
  .predictions-related h2 {
    font-size: 1.15rem;
    margin: 0 0 0.65rem;
  }

  .aggregation-note,
  .external-intro {
    font-size: 0.95rem;
    line-height: 1.45;
    opacity: 0.92;
  }
</style>
