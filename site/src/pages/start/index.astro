---
import SiteLayout from "../../layouts/SiteLayout.astro";
import FaqList from "../../components/FaqList.astro";
import { pdfHref } from "../../lib/site-urls";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<SiteLayout
  title="Start here"
  description="A slower introduction to Towards Superintelligence Alignment: reading path, book, field map, and common questions."
>
  <section class="hero">
    <h1>Start here</h1>
    <p class="lede">
      A powerful AI can seem helpful in a chat and still be the wrong thing to trust with real decisions.
      The question is whether people can still change its course when it goes wrong — not only whether it sounds nice today.
    </p>
    <div class="button-row">
      <a class="button primary" href={withBase("/paths/")}>Guided Tour</a>
      <a class="button" href={withBase("/book/")}>The book (PDF)</a>
      <a class="button" href={withBase("/field/")}>Who works on which problems</a>
    </div>
    <p class="side-panel-meta">
      This project does not claim the problem is solved.
      {" "}
      <a href={withBase("/cards/what-not-claiming/")}>What we are not claiming</a>
      {" · "}
      <a href={pdfHref(base)}>Download PDF</a>
    </p>
  </section>

  <h2>Questions</h2>
  <FaqList />
</SiteLayout>
